    ret("#a9afc0", 232, 268, 8, 26)
    ret("#a9afc0", 232, 288, 26, 7)
    ret("#ffffff", 150, 300, 180, 44)
    ret("#dfe8ec", 158, 306, 164, 22)
    ret("#c8d4da", 228, 316, 24, 6)

def desenharBoca():
    x0, w, y0, h = 90, 300, 120, 110
    ret("#12131a", x0 - 12, y0 - 12, w + 24, h + 24)
    ret("#d9463c", x0 - 8, y0 - 8, w + 16, h + 16)
    ret("#7a1f1a", x0, y0, w, h)
    ld = w / CONFIG["dentesQtd"]
    for i in range(CONFIG["dentesQtd"]):
        suj = f0.dentes[i]
        r = round(255 - 8 * (1 - suj))
        g = round(255 - 40 * suj)
        b = round(255 - 130 * suj)
        pygame.draw.rect(alvo, (r, g, b), (int(x0 + i * ld + 2), y0 + 2, int(ld - 4), 40))
        pygame.draw.rect(alvo, (r, g, b), (int(x0 + i * ld + 2), y0 + h - 42, int(ld - 4), 40))
        ret_borda("#c8c2ad", x0 + i * ld + 3, y0 + 3, ld - 6, 38, 2)
        ret_borda("#c8c2ad", x0 + i * ld + 3, y0 + h - 41, ld - 6, 38, 2)
    if f0.pior is not None and f0.dentes[f0.pior] > 0.02 and int(jogo.t * 5) % 2 == 0:
        sx = x0 + f0.pior * ld + ld / 2
        ret("#f7c948", sx - 10, y0 - 34, 20, 8)
        ret("#f7c948", sx - 6, y0 - 26, 12, 6)
        ret("#f7c948", sx - 3, y0 - 20, 6, 6)

def desenharManha():
    tarefa = f0.tarefa

    if tarefa == -1:
        desenharQuarto(False)
        sprite(SPR["tutiDormindo"], 50, 250, 3)
        tremida = math.sin(jogo.t * 30) * 3
        spriteC(SPR["despertador"], 264 + tremida, 242, 2)
        texto("RIIING!", 264, 208, 13, "#f7c948")

        painel(0, 44, W, 36)
        texto("A MANHÃ DO " + CONFIG["nomeMenino"], W / 2, 52, 20, "#f7c948")

        painel(128, 96, 176, 66, "#f2a3c7")
        texto(CONFIG["nomeTia"] + ", LÁ FORA:", 216, 102, 10, "#f2a3c7")
        texto('"BI BI! ' + CONFIG["nomeMenino"] + "!", 216, 120, 12)
        texto("ACORDA QUE HOJE", 216, 134, 11)
        texto('TEM ESCOLA!"', 216, 146, 11)

        if int(jogo.t * 2) % 2 == 0:
            texto("APERTE " + txAcao() + " PRA COMEÇAR", W / 2, 334, 14, "#f7c948")
        return

    if tarefa >= len(TAREFAS):
        # cena final: saindo de casa
        fundoNoite()
        CHAO = 322
        ret("#2c5f37", 0, 290, W, H - 290)
        ret("#3a3f4c", 0, 300, W, 42)
        ret("#8b8b7a", 0, 294, W, 6)
        ret("#d9cfae", 20, 168, 130, 126)
        ret("#a8402f", 10, 150, 150, 22)
        ret("#5b3a1a", 58, 224, 46, 70)
        ret("#2b1a0c", 64, 230, 34, 64)
        ret("#7fc4ff", 112, 190, 26, 24)
        spriteC(SPR["carroLado"], 356, CHAO - 12, 2)
        spriteC(SPR["nuna"], 262, CHAO - 21, 2)
        spriteC(SPR["tutiBaixo0"], 150, CHAO - 17, 2)

        texto("PRONTO PRA ESCOLA!", W / 2, HUD_H + 10, 22, "#f7c948")
        painel(70, 96, 340, 48, "#f2a3c7")
        texto('"BORA, ' + CONFIG["nomeMenino"] + '! ENTRA NO CARRO', W / 2, 102, 12, "#f2a3c7")
        texto('QUE A GENTE TÁ ATRASADO!"', W / 2, 118, 12, "#f2a3c7")
        if int(jogo.t * 2) % 2 == 0:
            texto(txAcao() + " = COMEÇAR A CORRIDA", W / 2, 332, 14, "#ffffff")
        return

    if tarefa == 0:
        claro = f0.prog > 55
        desenharQuarto(claro)
        tremida = math.sin(jogo.t * 30) * 3 if f0.prog < 100 else 0
        spriteC(SPR["despertador"], 264 + tremida, 242, 2)

        if f0.prog < 30:
            sprite(SPR["tutiDormindo"], 50, 250, 3)
            texto("ZZZzzz...", 150, 212, 14, "#c8c2ad")
        elif f0.prog < 62:
            sprite(SPR["tutiDormindo"], 50, 250, 3, {"k": "#f3c39a"})
            ret("#12131a", 50 + 3 * 3, 250 + 3 * 3, 3, 3)
            ret("#12131a", 50 + 7 * 3, 250 + 3 * 3, 3, 3)
            texto("HMMM...?", 150, 212, 14, "#f7c948")
        elif f0.prog < 100:
            spriteC(SPR["tutiBaixo0"], 92, 236, 3, corTuti())
            texto("QUASE LÁ!", 200, 200, 15, "#f7c948")
        else:
            spriteC(SPR["tutiBaixo0"], 150, 274, 3, corTuti())

    elif tarefa == 1:
        desenharCozinha()
        for c in f0.caindo:
            spriteC(SPR[c.tipo], c.x, c.y, 2)
        spriteC(SPR["tutiBaixo0"], f0.tutiX, 302, 3, corTuti())
        spriteC(SPR["prato"], f0.tutiX, 266, 3)
        painel(W / 2 - 64, 332, 128, 24)
        texto("CAFÉ: %d/%d" % (f0.pegos, CONFIG["cafeMeta"]), W / 2, 338, 13, "#f7c948")

    elif tarefa == 2:
        desenharBanheiro()
        desenharBoca()
        for e in f0.espuma:
            ret("#ffffff", int(e.x), int(e.y), 4, 4)
        balanco = math.sin(jogo.t * 22) * 3
        spriteC(SPR["escova"], f0.escova + balanco, 175, 3)
        spriteC(SPR["tutiBaixo0"], 54, 296, 3, corTuti())

    elif tarefa == 3:
        desenharQuarto(True)
        for p in ROUPAS:
            if f0.vestido[p["chave"]]:
                continue
            flut = math.sin(jogo.t * 3 + p["x"]) * 2
            ret("#5d6272", p["x"] - 2, 186, 4, 10)
            spriteC(SPR[p["spr"]], p["x"], 212 + flut, 3)
            if f0.perto is p and int(jogo.t * 5) % 2 == 0:
                ret("#f7c948", p["x"] - 3, 238, 6, 8)
                ret("#f7c948", p["x"] - 7, 234, 14, 5)
        q = int(jogo.t * 8) % 2 if f0.andando else 0
        spriteC(SPR["tutiLado1"] if q else SPR["tutiLado0"], f0.tutiX, 300, 3, corTuti(), f0.olhando == -1)
        if f0.perto:
            painel(f0.tutiX - 46, 248, 92, 22, "#f7c948")
            texto(txAcao() + "!", f0.tutiX, 252, 12, "#f7c948")

    if f0.fim > 0:
        ret_alpha((9, 11, 20, 140), 0, 0, W, H)
        painel(50, 150, 380, 56)
        texto(f0.msg, W / 2, 166, 22, "#f7c948")

    desenharHudManha()

def desenharHudManha():
    painel(0, 0, W, HUD_H)
    t = TAREFAS[f0.tarefa]
    texto("TAREFA %d/%d" % (f0.tarefa + 1, len(TAREFAS)), 10, 6, 10, "#f3c39a", "left")
    texto(t["titulo"], 10, 20, 15, "#f7c948", "left")
    texto(t["dica"].replace("%A", txAcao()), 470, 6, 10, "#c8c2ad", "right")
    barra(300, 20, 170, 16, f0.prog / 100, "#3fa34d")


# ==========================================================================
# FASE 1 — A CORRIDA PRA ESCOLA (e a volta, fase 5)
# ==========================================================================
ESTRADA_X0, ESTRADA_X1 = 80, 400
FAIXAS = [120, 200, 280, 360]
SLOTS = [120, 180, 240, 300, 360]

TRECHOS = [
    dict(nome="BAIRRO", aviso="SAINDO DE CASA!",
         grama="#2c5f37", asfalto="#3a3f4c", faixa="#f0e6c0",
         deco="casa", ritmo=1.3, chuva=False,
         pesos=[("cone", 0.55), ("poca", 0.25), ("carro", 0.20)]),
    dict(nome="AVENIDA", aviso="AVENIDA MOVIMENTADA!",
         grama="#4d5261", asfalto="#33384a", faixa="#f0e6c0",
         deco="predio", ritmo=0.92, chuva=False,
         pesos=[("cone", 0.20), ("poca", 0.15), ("carro", 0.65)]),
    dict(nome="RUA DA ESCOLA", aviso="CHUVA! CUIDADO COM AS POÇAS!",
         grama="#38553f", asfalto="#2c3242", faixa="#d9cfae",
         deco="arvore", ritmo=1.05, chuva=True,
         pesos=[("cone", 0.25), ("poca", 0.50), ("carro", 0.25)]),
]

TRECHOS_VOLTA = [
    dict(nome="SAINDO DA ESCOLA", aviso="VALENDO! ULTRAPASSA ELES!",
         grama="#4a6b3f", asfalto="#4a4438", faixa="#f0e6c0",
         deco="arvore", ritmo=1.15, chuva=False,
         pesos=[("cone", 0.45), ("poca", 0.30), ("carro", 0.25)]),
    dict(nome="AVENIDA", aviso="AVENIDA CHEIA! CUIDADO!",
         grama="#6b5a48", asfalto="#453b30", faixa="#f0e6c0",
         deco="predio", ritmo=0.9, chuva=False,
         pesos=[("cone", 0.20), ("poca", 0.15), ("carro", 0.65)]),
    dict(nome="CHEGANDO EM CASA", aviso="TÁ QUASE! ACELERA!",
         grama="#4a5240", asfalto="#37333f", faixa="#d9cfae",
         deco="casa", ritmo=1.0, chuva=False,
         pesos=[("cone", 0.40), ("poca", 0.25), ("carro", 0.35)]),
]

RIVAIS_COR = [
    {"d": "#c9503a", "c": "#f0b8a8"},
    {"d": "#3fa34d", "c": "#a8e0b0"},
    {"d": "#7a5ac9", "c": "#c8b8f0"},
]

AMIGOS = [
    dict(nome="JOÃO", cor={"g": "#f7c948", "G": "#c08f14", "H": "#12131a", "A": "#2b2f3d"}),
    dict(nome="MARIA", cor={"g": "#f2a3c7", "G": "#c26e95", "H": "#b0793f", "A": "#3f6fd1"}),
    dict(nome="PEDRO", cor={"g": "#7fc4ff", "G": "#3f6fd1", "H": "#7a4a24", "A": "#2b2f3d"}),
]

f1 = NS(amigos=[], rivais=[], volta=False)

def trechosDaFase():
    return TRECHOS_VOLTA if f1.volta else TRECHOS

def trechoDe(dist):
    t = trechosDaFase()
    return min(len(t) - 1, int(dist / (CONFIG["distTotal"] / len(t))))

def posicaoNaCorrida():
    if not f1.rivais:
        return 1
    return 1 + sum(1 for r in f1.rivais if r.dist > f1.dist)

def ordinal(n):
    return "%dº" % n

def iniciarFase1(volta=False):
    f1.volta = bool(volta)
    abrirFase(
        "FASE 5 — A CORRIDA DE VOLTA PRA CASA" if f1.volta else "FASE 2 — A CORRIDA PRA ESCOLA",
        lambda: iniciarFase1(f1.volta),
    )
    f1.carroX = 240.0
    f1.carroY = 280.0
    f1.vel = CONFIG["velBase"]
    f1.dist = 0.0
    f1.combustivel = float(CONFIG["combustivelMax"])
    f1.obstaculos = []
    f1.coletaveis = []
    f1.tSpawn = 1.2
    f1.tItem = 2.0
    f1.invenc = 0.0
    f1.turbo = 0.0
    f1.turboCd = 0.0
    f1.chegou = False
    f1.chegouT = 0.0
    f1.aviso = ""
    f1.avisoT = 0.0
    f1.trecho = 0
    f1.posFinal = 1

    f1.amigos = []
    if not f1.volta:
        pedaco = CONFIG["distTotal"] / CONFIG["amigos"]
        for i in range(CONFIG["amigos"]):
            f1.amigos.append(NS(
                idx=i,
                distAlvo=(i + 0.55) * pedaco,
                x=FAIXAS[0] if i % 2 == 0 else FAIXAS[3],
                y=-120.0,
                nascido=False, pego=False, perdido=False, avisado=False,
            ))

    f1.rivais = []
    if f1.volta:
        for i in range(CONFIG["qtdRivais"]):
            x0 = SLOTS[0 if i == 0 else 2 if i == 1 else 4]
            f1.rivais.append(NS(
                idx=i,
                dist=60.0 + i * 40,
                x=float(x0),
                alvoX=float(x0),
                vel=CONFIG["velRival"][i],
                tFaixa=1.5 + i,
                y=0.0,
            ))
    f1.melhorPos = CONFIG["qtdRivais"] + 1
    trocarEstado("FASE1")

def avisoF1(txt, dur=2):
    f1.aviso = txt
    f1.avisoT = dur

def amigosPegos():
    return sum(1 for a in f1.amigos if a.pego)

def faixasOcupadas():
    return [a.x for a in f1.amigos if a.nascido and not a.pego and a.y < H]

def sortearTipo(pesos):
    s = random.random()
    for p in pesos:
        s -= p[1]
        if s <= 0:
            return p[0]
    return pesos[0][0]

def nascerObstaculo():
    t = trechosDaFase()[f1.trecho]
    ocupadas = faixasOcupadas()
    livres = [x for x in SLOTS if not any(abs(o - x) < 61 for o in ocupadas)]
    if not livres:
        return
    prog = f1.dist / CONFIG["distTotal"]
    quantos = 2 if prog > 0.35 and len(livres) > 3 and random.random() < 0.45 else 1
    for _n in range(quantos):
        if not livres:
            break
        x = random.choice(livres)
        livres = [s for s in livres if abs(s - x) > 61]
        tipo = sortearTipo(t["pesos"])
        f1.obstaculos.append(NS(
            tipo=tipo, x=float(x), y=-70.0,
            velRel=-95 if tipo == "carro" else 0,
            batido=False,
        ))

def nascerColetavel():
    x = random.choice(FAIXAS)
    tipo = "gasolina" if f1.combustivel < 45 or random.random() < 0.4 else "estrela"
    f1.coletaveis.append(NS(tipo=tipo, x=float(x), y=-40.0, pego=False))

def caixaObstaculo(o):
    if o.tipo == "cone":
        return 20, 24
    if o.tipo == "poca":
        return 28, 16
    return 32, 40

def bateu(ax, ay, aw, ah, bx, by, bw, bh):
    return abs(ax - bx) * 2 < aw + bw and abs(ay - by) * 2 < ah + bh

def atualizarFase1(dt):
    # ------- chegada -------
    if f1.chegou:
        f1.chegouT += dt
        f1.dist += max(0, CONFIG["velBase"] * (1 - f1.chegouT / 1.6)) * dt
        if f1.carroY > 235:
            f1.carroY -= 40 * dt
        for o in f1.obstaculos:
            o.y += 200 * dt
        f1.obstaculos = [o for o in f1.obstaculos if o.y < H + 60]
        if f1.chegouT > 3.4:
            if f1.volta:
                pos = f1.posFinal
                jogo.pontos += 500 + [900, 500, 250, 100][pos - 1]
                mostrarTransicao(
                    "CHEGAMOS EM CASA!",
                    "VOCÊ TERMINOU EM " + ordinal(pos) + " LUGAR!",
                    "AGORA UM PEGA-PEGA NO QUINTAL!",
                    iniciarQuintal,
                )
            else:
                jogo.pontos += 500 + amigosPegos() * 200
                SFX.fase()
                trocarEstado("INTERVALO")
        return

    # ------- velocidade e turbo -------
    if foiApertada("Space") and f1.turboCd <= 0:
        f1.turbo = CONFIG["turboDur"]
        f1.turboCd = CONFIG["turboRecarga"]
        SFX.turbo()
    f1.turboCd = max(0.0, f1.turboCd - dt)

    vel = CONFIG["velBase"]
    if teclas.get("ArrowUp"):
        vel = CONFIG["velMax"]
    elif teclas.get("ArrowDown"):
        vel = CONFIG["velMin"]
    if f1.turbo > 0:
        vel = CONFIG["turboVel"]
        f1.turbo -= dt
    f1.vel = vel

    # ------- movimento lateral -------
    if teclas.get("ArrowLeft"):
        f1.carroX -= CONFIG["velLateral"] * dt
    if teclas.get("ArrowRight"):
        f1.carroX += CONFIG["velLateral"] * dt
    f1.carroX = max(ESTRADA_X0 + 20, min(ESTRADA_X1 - 20, f1.carroX))

    # ------- distância, combustível, pontos -------
    f1.dist += vel * dt
    jogo.pontos += vel * dt * 0.08
    f1.combustivel -= CONFIG["gastoCombustivel"] * dt
    if f1.combustivel <= 0:
        f1.combustivel = 45
        avisoF1("ACABOU A GASOLINA!")
        if perderVida():
            return
        f1.invenc = CONFIG["invencivel"]

    # ------- mudou de trecho? -------
    novoTrecho = trechoDe(f1.dist)
    if novoTrecho != f1.trecho:
        f1.trecho = novoTrecho
        avisoF1(trechosDaFase()[novoTrecho]["aviso"], 2.8)
        SFX.fase()

    # ------- rivais (volta) -------
    for r in f1.rivais:
        atras = f1.dist - r.dist
        ajuste = max(-CONFIG["elastico"], min(CONFIG["elastico"], atras * 0.05))
        r.dist += (r.vel + ajuste) * dt

        r.tFaixa -= dt
        if r.tFaixa <= 0:
            r.alvoX = float(random.choice(SLOTS))
            r.tFaixa = 2.2 + random.random() * 2.5
        delta = r.alvoX - r.x
        if delta != 0:
            r.x += math.copysign(min(abs(delta), 70 * dt), delta)

        r.y = f1.carroY - (r.dist - f1.dist)
        if f1.invenc <= 0 and bateu(f1.carroX, f1.carroY, 22, 30, r.x, r.y, 26, 34):
            f1.invenc = CONFIG["invencivel"]
            avisoF1("ENCOSTOU NO OUTRO CARRO!")
            if perderVida():
                return
    if f1.volta:
        pos = posicaoNaCorrida()
        if pos < f1.melhorPos:
            f1.melhorPos = pos
            if pos == 1:
                avisoF1("TÁ EM PRIMEIRO!", 1.8)

    # ------- coleguinhas no ponto -------
    for a in f1.amigos:
        if a.pego or a.perdido:
            continue
        if not a.avisado and f1.dist >= a.distAlvo - CONFIG["avisoAmigo"]:
            a.avisado = True
            avisoF1("AMIGO NO PONTO À " + ("ESQUERDA" if a.x < 240 else "DIREITA") + "!", 2.6)
            SFX.coleta()
        if not a.nascido:
            if f1.dist >= a.distAlvo:
                a.nascido = True
                a.y = -120.0
                f1.tSpawn = max(f1.tSpawn, 1.3)
            continue
        a.y += vel * dt
        if a.y > H + 60:
            a.perdido = True
            continue
        if bateu(f1.carroX, f1.carroY, 40, 48, a.x, a.y, 24, 30):
            a.pego = True
            jogo.pontos += 150
            SFX.item()
            avisoF1(AMIGOS[a.idx]["nome"] + " ENTROU NO CARRO!", 2)

    # ------- nascimento -------
    f1.tSpawn -= dt
    if f1.tSpawn <= 0:
        nascerObstaculo()
        prog = f1.dist / CONFIG["distTotal"]
        f1.tSpawn = CONFIG["intervaloObstaculo"] * TRECHOS[f1.trecho]["ritmo"] * (1 - prog * 0.25) + random.random() * 0.4
    f1.tItem -= dt
    if f1.tItem <= 0:
        nascerColetavel()
        f1.tItem = CONFIG["intervaloItem"] + random.random() * 1.6

    # ------- mover e colidir -------
    f1.invenc = max(0.0, f1.invenc - dt)
    if f1.avisoT > 0:
        f1.avisoT -= dt

    for o in f1.obstaculos:
        o.y += (vel + o.velRel) * dt
    f1.obstaculos = [o for o in f1.obstaculos if -220 < o.y < H + 80]

    for o in f1.obstaculos:
        if o.batido:
            continue
        cw, ch = caixaObstaculo(o)
        if bateu(f1.carroX, f1.carroY, 22, 30, o.x, o.y, cw - 6, ch - 6):
            o.batido = True
            if f1.invenc > 0:
                continue
            f1.invenc = CONFIG["invencivel"]
            avisoF1("CUIDADO COM A POÇA!" if o.tipo == "poca" else "AI! DESVIA!")
            if perderVida():
                return

    for c in f1.coletaveis:
        c.y += vel * dt
    for c in f1.coletaveis:
        if c.pego:
            continue
        if bateu(f1.carroX, f1.carroY, 34, 44, c.x, c.y, 22, 24):
            c.pego = True
            if c.tipo == "gasolina":
                f1.combustivel = min(CONFIG["combustivelMax"], f1.combustivel + 32)
                jogo.pontos += 20
                SFX.coleta()
            else:
                jogo.pontos += 60
                SFX.item()
    f1.coletaveis = [c for c in f1.coletaveis if not c.pego and c.y < H + 40]

    if f1.dist >= CONFIG["distTotal"]:
        f1.chegou = True
        f1.chegouT = 0.0
        f1.posFinal = posicaoNaCorrida()

def desenharCasaDeCima(x, y, w, h):
    ret("#d9cfae", x, y + 24, w, h - 24)
    ret("#c0b492", x, y + h - 12, w, 12)
    ret("#a8402f", x - 10, y + 10, w + 20, 16)
    ret("#c9503a", x - 6, y, w + 12, 12)
    ret("#2b3d63", x + w / 2 - 56, y + 32, 112, 18)
    texto("CASA DOCE CASA", x + w / 2, y + 36, 10, "#f7c948")
    for jx in (x + 16, x + w - 46):
        ret("#2b3d63", jx, y + 60, 30, 26)
        ret("#f7c948", jx + 3, y + 63, 24, 20)
    ret("#5b3a1a", x + w / 2 - 22, y + 62, 44, h - 62)
    ret("#f7c948", x + w / 2 + 12, y + 84, 5, 5)

def desenharEscola(x, y, w, h):
    ret("#d9cfae", x, y + 26, w, h - 26)
    ret("#c0b492", x, y + h - 14, w, 14)
    ret("#a8402f", x - 10, y + 12, w + 20, 16)
    ret("#c9503a", x - 6, y, w + 12, 14)
    ret("#2b3d63", x + w / 2 - 78, y + 34, 156, 20)
    texto(CONFIG["nomeEscola"], x + w / 2, y + 38, 12, "#f7c948")
    for i in range(4):
        jx = x + 14 + i * (w - 28) / 4
        if i in (1, 2):
            continue
        ret("#2b3d63", jx, y + 62, 30, 26)
        ret("#7fc4ff", jx + 3, y + 65, 24, 20)
    ret("#2b3d63", x + w / 2 - 30, y + 60, 60, h - 60)
    for i in range(5):
        ret("#3f6fd1", x + w / 2 - 26 + i * 11, y + 64, 5, h - 68)

def desenharDeco(tipo, x, y):
    if tipo == "casa":
        ret("#d9cfae", x - 22, y + 12, 44, 32)
        ret("#a8402f", x - 26, y, 52, 14)
        ret("#c9503a", x - 22, y + 12, 44, 5)
        ret("#7fc4ff", x - 15, y + 22, 12, 12)
        ret("#5b3a1a", x + 5, y + 24, 12, 20)
    elif tipo == "predio":
        ret("#4a4f60", x - 24, y - 26, 48, 74)
        ret("#5d6272", x - 24, y - 26, 48, 6)
        for a in range(4):
            for b in range(3):
                cor = "#f7c948" if (a + b + int(y)) % 3 == 0 else "#2a2f3d"
                ret(cor, x - 17 + b * 14, y - 16 + a * 16, 9, 10)
    else:
        ret("#5b3a1a", x - 4, y + 26, 8, 18)
        ret("#276b32", x - 20, y, 40, 30)
        ret("#3fa34d", x - 16, y + 3, 32, 20)

def desenharPonto(x, y):
    ret("#5d6272", x - 2, y, 4, 34)
    ret("#3f6fd1", x - 14, y - 16, 28, 18)
    ret("#f7c948", x - 11, y - 13, 22, 12)
    ret("#12131a", x - 8, y - 9, 16, 4)

def desenharFase1():
    tr = trechosDaFase()[f1.trecho]

    alvo.set_clip(pygame.Rect(0, HUD_H, W, H - HUD_H))

    ret(tr["grama"], 0, HUD_H, W, H - HUD_H)
    ret(tr["asfalto"], ESTRADA_X0, HUD_H, ESTRADA_X1 - ESTRADA_X0, H - HUD_H)
    off = f1.dist % 40
    y = HUD_H - 40 + off
    while y < H:
        ret("#e8e8e8", ESTRADA_X0 - 8, y, 8, 20)
        ret("#d9463c", ESTRADA_X0 - 8, y + 20, 8, 20)
        ret("#e8e8e8", ESTRADA_X1, y, 8, 20)
        ret("#d9463c", ESTRADA_X1, y + 20, 8, 20)
        y += 40
    for dx in (160, 240, 320):
        y = HUD_H - 60 + (f1.dist % 60)
        while y < H:
            ret(tr["faixa"], dx - 2, y, 4, 28)
            y += 60
    offA = f1.dist % 130
    y = HUD_H - 130 + offA
    while y < H + 80:
        desenharDeco(tr["deco"], 36, y)
        desenharDeco(tr["deco"], 444, y)
        y += 130

    if f1.chegou:
        p = min(1.0, f1.chegouT / 1.7)
        ey = -250 + p * 300
        if f1.volta:
            desenharCasaDeCima(110, ey + 20, 260, 170)
        else:
            desenharEscola(70, ey, 340, 190)

    for r in f1.rivais:
        if r.y < -70 or r.y > H + 70:
            continue
        spriteC(SPR["carro"], r.x, r.y, 2, RIVAIS_COR[r.idx])

    for a in f1.amigos:
        if not a.nascido or a.pego or a.y > H + 40:
            continue
        desenharPonto(ESTRADA_X0 - 32 if a.x < 240 else ESTRADA_X1 + 32, a.y - 24)
        pulo = abs(math.sin(jogo.t * 6)) * 3
        spriteC(SPR["tutiBaixo0"], a.x, a.y - pulo, 2, AMIGOS[a.idx]["cor"])
        if int(jogo.t * 6) % 2 == 0:
            ret("#f7c948", a.x - 5, a.y - 34, 10, 5)
            ret("#f7c948", a.x - 2, a.y - 29, 4, 5)

    for c in f1.coletaveis:
        spriteC(SPR["gasolina" if c.tipo == "gasolina" else "estrela"], c.x, c.y, 2)

    for o in f1.obstaculos:
        if o.tipo == "cone":
            spriteC(SPR["cone"], o.x, o.y, 2)
        elif o.tipo == "poca":
            spriteC(SPR["poca"], o.x, o.y, 2)
        else:
            spriteC(SPR["carroFrente"], o.x, o.y, 2, {"d": "#c9503a", "c": "#f0b8a8"})

    if f1.turbo > 0:
        for i in range(5):
            ret("#f7c948" if i % 2 else "#e8853a",
                f1.carroX - 12 + random.random() * 24, f1.carroY + 22 + i * 7, 5, 6)

    piscando = f1.invenc > 0 and int(f1.invenc * 12) % 2 == 0
    if not piscando:
        spriteC(SPR["carro"], f1.carroX, f1.carroY, 2)

    if tr["chuva"]:
        ret_alpha((96, 132, 200, 40), 0, HUD_H, W, H - HUD_H)
        for i in range(70):
            x = (i * 71 + f1.dist * 0.6) % W
            yy = HUD_H + ((i * 47 + f1.dist * 2.6) % (H - HUD_H))
            ret_alpha((190, 225, 255, 140), int(x), int(yy), 1, 8)

    if f1.avisoT > 0:
        lt = medir(f1.aviso, 16) + 24
        painel(W / 2 - lt / 2, 112, lt, 28)
        texto(f1.aviso, W / 2, 118, 16, "#f7c948")

    if f1.chegou:
        n = 0
        for a in f1.amigos:
            if not a.pego:
                continue
            spriteC(SPR["tutiBaixo0"], f1.carroX + 34 + n * 26, f1.carroY + 6, 2, AMIGOS[a.idx]["cor"])
            n += 1
        texto("CHEGAMOS EM CASA!" if f1.volta else "CHEGAMOS NA ESCOLA!", W / 2, 250, 20, "#f7c948")
    elif f1.turboCd <= 0:
        texto(txAcao() + " = TURBO!", W / 2, H - 26, 12, "#f7c948")

    alvo.set_clip(None)
    desenharHudFase1()

def desenharCoracoes(x, y):
    for i in range(CONFIG["vidas"]):
        cheio = i < jogo.vidas
        sprite(SPR["coracao"], x + i * 18, y, 2, None if cheio else {"r": "#3a3f4c"})

def desenharHudFase1():
    painel(0, 0, W, HUD_H)
    desenharCoracoes(10, 16)

    texto("GASOLINA", 82, 5, 10, "#f3c39a", "left")
    frac = f1.combustivel / CONFIG["combustivelMax"]
    barra(82, 19, 116, 16, frac, "#d9463c" if frac < 0.25 else "#3fa34d")

    texto(trechosDaFase()[f1.trecho]["nome"], 210, 5, 10, "#f3c39a", "left")
    barra(210, 19, 110, 16, f1.dist / CONFIG["distTotal"], "#f7c948")

    if f1.volta:
        pos = f1.posFinal if f1.chegou else posicaoNaCorrida()
        texto("LUGAR", 332, 5, 10, "#f3c39a", "left")
        texto(ordinal(pos), 332, 17, 20, "#f7c948" if pos == 1 else "#ffffff", "left")
    else:
        texto("AMIGOS", 332, 5, 10, "#f3c39a", "left")
        for i in range(len(f1.amigos)):
            sprite(SPR["carinha"], 332 + i * 17, 20, 2, AMIGOS[i]["cor"] if f1.amigos[i].pego else CINZA)

    texto("PONTOS", 470, 4, 10, "#f3c39a", "right")
    texto(str(int(jogo.pontos)).zfill(6), 470, 17, 18, "#f7c948", "right")


# ==========================================================================
# FASE 2 — DESAFIOS NA ESCOLA
# ==========================================================================
TILE = 24
MAPA_Y = 48
MAPA = [
    "####################",
    "#..................#",
    "#.###.####.###.###.#",
    "#.###....#.###.###.#",
    "#.###.####.###.###.#",
    "#..................#",
    "#.###.####.###.....#",
    "#.###.####.....###.#",
    "#.###.####.###.###.#",
    "#..................#",
    "#.....####.###.###.#",
    "#..................#",
    "####################",
]
MAPA_COLS = len(MAPA[0])
MAPA_ROWS = len(MAPA)

POS = dict(
    inicio=dict(c=1, r=1),
    nuna=dict(c=5, r=5),
    porta=dict(c=18, r=11),
    lapis=dict(c=8, r=3),
    chave=dict(c=16, r=6),
    mochila=dict(c=12, r=7),
    lanche=dict(c=3, r=10),
)

def cx(c):
    return c * TILE + TILE / 2

def cy(r):
    return MAPA_Y + r * TILE + TILE / 2

ITENS = [
    dict(chave="mochila", spr="mochila", nome="MOCHILA"),
    dict(chave="lapis", spr="lapis", nome="LÁPIS"),
    dict(chave="lanche", spr="lanche", nome="LANCHE"),
    dict(chave="chave", spr="chave", nome="CHAVE"),
]

f2 = NS()

def iniciarFase2():
    abrirFase("FASE 3 — DESAFIOS NA ESCOLA", iniciarFase2)
    f2.x = cx(POS["inicio"]["c"])
    f2.y = cy(POS["inicio"]["r"])
    f2.dir = "baixo"
    f2.anim = 0.0
    f2.andando = False
    f2.pegos = dict(mochila=False, lapis=False, lanche=False, chave=False)
    f2.invenc = 0.0
    f2.grito = 0.0
    f2.gritoCd = 0.0
    f2.msg = ""
    f2.msgT = 0.0
    f2.nunaFalou = False
    f2.pertoNuna = False
    f2.monstros = [
        NS(eixo="h", x=cx(9), y=cy(9), min=cx(2), max=cx(17), dir=1),
        NS(eixo="v", x=cx(10), y=cy(3), min=cy(1), max=cy(11), dir=1),
    ]
    trocarEstado("FASE2")

def msgF2(txt, dur=2.4):
    f2.msg = txt
    f2.msgT = dur

def paredeEm(px, py):
    c = int(px // TILE)
    r = int((py - MAPA_Y) // TILE)
    if r < 0 or r >= MAPA_ROWS or c < 0 or c >= MAPA_COLS:
        return True
    return MAPA[r][c] == "#"

def livre(px, py):
    h = 8
    return (not paredeEm(px - h, py - h) and not paredeEm(px + h, py - h)
            and not paredeEm(px - h, py + h) and not paredeEm(px + h, py + h))

def centroX(px):
    return (px // TILE) * TILE + TILE / 2

def centroY(py):
    return MAPA_Y + ((py - MAPA_Y) // TILE) * TILE + TILE / 2

def aproximar(v, alvo_v, passo):
    if abs(alvo_v - v) <= passo:
        return alvo_v
    return v + math.copysign(passo, alvo_v - v)

DIRS = {
    "ArrowLeft": NS(dx=-1, dy=0, nome="esq"),
    "ArrowRight": NS(dx=1, dy=0, nome="dir"),
    "ArrowUp": NS(dx=0, dy=-1, nome="cima"),
    "ArrowDown": NS(dx=0, dy=1, nome="baixo"),
}

def _direcao_atual():
    for i in range(len(ordemSetas) - 1, -1, -1):
        if teclas.get(ordemSetas[i]):
            return DIRS[ordemSetas[i]]
    return None

def atualizarFase2(dt):
    f2.invenc = max(0.0, f2.invenc - dt)
    f2.gritoCd = max(0.0, f2.gritoCd - dt)
    if f2.grito > 0:
        f2.grito -= dt
    if f2.msgT > 0:
        f2.msgT -= dt

    if foiApertada("Space") and f2.gritoCd <= 0:
        f2.grito = CONFIG["gritoDur"]
        f2.gritoCd = CONFIG["gritoRecarga"]
        SFX.grito()
        msgF2("GRITO DE CORAGEM!", 1.2)

    # ------- movimento -------
    d = _direcao_atual()
    f2.andando = False
    if d:
        f2.dir = d.nome
        v = CONFIG["velTuti"] * dt
        if d.dx != 0:
            alvo_v = centroY(f2.y)
            if f2.y != alvo_v:
                ny = aproximar(f2.y, alvo_v, v)
                if livre(f2.x, ny):
                    f2.y = ny
                    f2.andando = True
            if livre(f2.x + d.dx * v, f2.y):
                f2.x += d.dx * v
                f2.andando = True
        else:
            alvo_v = centroX(f2.x)
            if f2.x != alvo_v:
                nx = aproximar(f2.x, alvo_v, v)
                if livre(nx, f2.y):
                    f2.x = nx
                    f2.andando = True
            if livre(f2.x, f2.y + d.dy * v):
                f2.y += d.dy * v
                f2.andando = True
    if f2.andando:
        f2.anim += dt * 8
    else:
        f2.anim = 0.0

    # ------- itens -------
    for it in ITENS:
        if f2.pegos[it["chave"]]:
            continue
        p = POS[it["chave"]]
        if abs(f2.x - cx(p["c"])) < 18 and abs(f2.y - cy(p["r"])) < 18:
            f2.pegos[it["chave"]] = True
            jogo.pontos += 200
            SFX.item()
            msgF2("PEGOU A " + it["nome"] + "!", 1.8)

    # ------- Tia Nuna -------
    if abs(f2.x - cx(POS["nuna"]["c"])) < 30 and abs(f2.y - cy(POS["nuna"]["r"])) < 30:
        if not f2.nunaFalou:
            f2.nunaFalou = True
            if jogo.vidas < CONFIG["vidas"]:
                jogo.vidas += 1
            SFX.coleta()
            msgF2("A CHAVE TÁ LÁ NA DIREITA!", 3.5)
        f2.pertoNuna = True
    else:
        f2.pertoNuna = False

    # ------- monstrinhos -------
    if f2.grito <= 0:
        for m in f2.monstros:
            v = CONFIG["velMonstro"] * dt * m.dir
            if m.eixo == "h":
                m.x += v
                if m.x <= m.min:
                    m.x = m.min
                    m.dir = 1
                if m.x >= m.max:
                    m.x = m.max
                    m.dir = -1
            else:
                m.y += v
                if m.y <= m.min:
                    m.y = m.min
                    m.dir = 1
                if m.y >= m.max:
                    m.y = m.max
                    m.dir = -1

    if f2.invenc <= 0:
        for m in f2.monstros:
            if abs(f2.x - m.x) < 18 and abs(f2.y - m.y) < 18:
                f2.invenc = CONFIG["invencivel"]
                msgF2("A BAGUNÇA TE PEGOU!", 2)
                f2.x = cx(POS["inicio"]["c"])
                f2.y = cy(POS["inicio"]["r"])
                f2.dir = "baixo"
                if perderVida():
                    return
                break

    # ------- porta -------
    dp = abs(f2.x - cx(POS["porta"]["c"])) < 16 and abs(f2.y - cy(POS["porta"]["r"])) < 16
    if dp:
        if all(f2.pegos[it["chave"]] for it in ITENS):
            jogo.pontos += 1000 + jogo.vidas * 300
            mostrarTransicao(
                "CHEGOU NA SALA!",
                "AULA DADA, BARRIGA CHEIA...",
                "AGORA É HORA DO RECREIO!",
                iniciarRecreio,
            )
        elif f2.msgT <= 0:
            msgF2("FALTA PEGAR OS ITENS!", 2)
            SFX.porta()

def desenharParede(x, y):
    ret("#3b4a63", x, y, TILE, TILE)
    ret("#4d6280", x, y, TILE, 4)
    ret("#2a3548", x, y + 11, TILE, 2)
    ret("#2a3548", x + 11, y, 2, 11)
    ret("#2a3548", x + 5, y + 13, 2, 11)
    ret("#2a3548", x + 17, y + 13, 2, 11)

def desenharFase2():
    ret("#151a26", 0, HUD_H, W, H - HUD_H)

    for r in range(MAPA_ROWS):
        for c in range(MAPA_COLS):
            x, y = c * TILE, MAPA_Y + r * TILE
            if MAPA[r][c] == "#":
                desenharParede(x, y)
                continue
            ret("#c8c2ad" if (r + c) % 2 else "#b8b19a", x, y, TILE, TILE)

    px = POS["porta"]["c"] * TILE
    py = MAPA_Y + POS["porta"]["r"] * TILE
    completo = all(f2.pegos[it["chave"]] for it in ITENS)
    ret("#f7c948" if completo else "#8b5a2b", px + 1, py + 1, TILE - 2, TILE - 2)
    ret("#fff2b0" if completo else "#6b421d", px + 4, py + 4, TILE - 8, 9)
    ret("#12131a", px + TILE - 8, py + TILE / 2, 3, 3)
    if completo and int(jogo.t * 4) % 2 == 0:
        ret_borda("#fff2b0", px + 1, py + 1, TILE - 2, TILE - 2, 2)
    texto("SALA", px + TILE / 2, py - 14, 10, "#f7c948" if completo else "#c8c2ad")

    for it in ITENS:
        if f2.pegos[it["chave"]]:
            continue
        p = POS[it["chave"]]
        flut = math.sin(jogo.t * 3 + p["c"]) * 2
        spriteC(SPR[it["spr"]], cx(p["c"]), cy(p["r"]) + flut, 2)

    spriteC(SPR["nuna"], cx(POS["nuna"]["c"]), cy(POS["nuna"]["r"]) - 6, 2)

    for m in f2.monstros:
        tremida = math.sin(jogo.t * 40) * 2 if f2.grito > 0 else 0
        spriteC(SPR["monstro"], m.x + tremida, m.y, 2,
                {"c": "#7fc4ff", "w": "#dff0ff"} if f2.grito > 0 else None)

    piscando = f2.invenc > 0 and int(f2.invenc * 12) % 2 == 0
    if not piscando:
        q = int(f2.anim) % 2
        esp = False
        if f2.dir == "cima":
            spr = SPR["tutiCima1"] if q else SPR["tutiCima0"]
        elif f2.dir == "baixo":
            spr = SPR["tutiBaixo1"] if q else SPR["tutiBaixo0"]
        else:
            spr = SPR["tutiLado1"] if q else SPR["tutiLado0"]
            esp = f2.dir == "esq"
        spriteC(spr, f2.x, f2.y - 6, 2, None, esp)

    if f2.msgT > 0:
        larguraTxt = medir(f2.msg, 12) + 20
        bx = max(6, min(W - larguraTxt - 6, f2.x - larguraTxt / 2))
        by = max(HUD_H + 4, f2.y - 44)
        painel(bx, by, larguraTxt, 22, "#f7c948")
        texto(f2.msg, bx + larguraTxt / 2, by + 5, 12, "#ffffff")

    desenharHudFase2()

def desenharHudFase2():
    painel(0, 0, W, HUD_H)
    desenharCoracoes(10, 16)

    for i, it in enumerate(ITENS):
        x, y = 82 + i * 30, 12
        pego = f2.pegos[it["chave"]]
        ret_alpha((63, 163, 77, 90) if pego else (255, 255, 255, 20), x - 2, y - 2, 28, 28)
        spriteC(SPR[it["spr"]], x + 12, y + 12, 2, None if pego else CINZA)

    texto("GRITO", 214, 5, 10, "#f3c39a", "left")
    pronto = f2.gritoCd <= 0
    barra(214, 19, 100, 16, 1 if pronto else 1 - f2.gritoCd / CONFIG["gritoRecarga"],
          "#f7c948" if pronto else "#5d6272")
    if pronto and int(jogo.t * 3) % 2 == 0:
        texto("!", 320, 18, 16, "#f7c948", "left")

    texto("PONTOS", 470, 4, 10, "#f3c39a", "right")
    texto(str(int(jogo.pontos)).zfill(6), 470, 17, 18, "#f7c948", "right")

# ==========================================================================
# FASE 4 — RECREIO: ESCONDE-ESCONDE NO PÁTIO
# ==========================================================================
def andarContornando(px, py, d, v, livre_fn):
    if livre_fn(px + d.dx * v, py + d.dy * v):
        return px + d.dx * v, py + d.dy * v, True
    perp = [(0, -1), (0, 1)] if d.dx else [(-1, 0), (1, 0)]
    alcance = 6
    while alcance <= 30:
        for pxy in perp:
            if not livre_fn(px + pxy[0] * alcance, py + pxy[1] * alcance):
                continue
            if not livre_fn(px + pxy[0] * alcance + d.dx * v, py + pxy[1] * alcance + d.dy * v):
                continue
            mx, my = px + pxy[0] * v, py + pxy[1] * v
            if livre_fn(mx, my):
                return mx, my, True
        alcance += 6
    return px, py, False

PATIO_Y = 46
ESCONDERIJOS = [
    dict(spr="arvore", x=72, y=132, esc=5),
    dict(spr="arbusto", x=200, y=108, esc=4),
    dict(spr="escorrega", x=402, y=132, esc=4),
    dict(spr="banco", x=94, y=294, esc=4),
    dict(spr="caixaDagua", x=248, y=308, esc=4),
    dict(spr="arvore", x=416, y=288, esc=5),
]

PISTAS = [
    dict(d=999, txt="TÁ GELADO...", cor="#7fc4ff"),
    dict(d=210, txt="TÁ FRIO", cor="#7fc4ff"),
    dict(d=150, txt="TÁ MORNO", cor="#f7c948"),
    dict(d=95, txt="TÁ QUENTE!", cor="#e8853a"),
    dict(d=55, txt="PEGANDO FOGO!", cor="#d9463c"),
]

f4 = NS()

def iniciarRecreio():
    abrirFase("FASE 4 — RECREIO NA ESCOLA", iniciarRecreio)
    f4.x = 240.0
    f4.y = 190.0
    f4.dir = "baixo"
    f4.anim = 0.0
    f4.andando = False
    f4.msg = ""
    f4.msgT = 0.0
    f4.tRisada = CONFIG["intervaloRisada"]
    f4.risada = None
    f4.risadaT = 0.0
    f4.tempo = 0.0

    indices = list(range(len(ESCONDERIJOS)))
    random.shuffle(indices)
    f4.locais = [NS(ref=e, i=i, amigo=-1, espiado=False) for i, e in enumerate(ESCONDERIJOS)]
    for a in range(len(AMIGOS)):
        f4.locais[indices[a]].amigo = a
    f4.achados = 0
    trocarEstado("RECREIO")

def msgF4(txt, dur=1.8):
    f4.msg = txt
    f4.msgT = dur

def livreNoPatio(px, py):
    if px < 26 or px > W - 26 or py < PATIO_Y + 26 or py > H - 20:
        return False
    for l in f4.locais:
        e = l.ref
        lw = larg(SPR[e["spr"]]) * e["esc"] / 2
        lh = len(SPR[e["spr"]]) * e["esc"] / 2
        if abs(px - e["x"]) < lw - 2 and abs(py - e["y"]) < lh - 2:
            return False
    return True

def distAte(l):
    return math.hypot(f4.x - l.ref["x"], f4.y - l.ref["y"])

def pistaAtual():
    melhor, dist = None, float("inf")
    for l in f4.locais:
        if l.espiado or l.amigo < 0:
            continue
        d = distAte(l)
        if d < dist:
            dist = d
            melhor = l
    return melhor, dist

def atualizarRecreio(dt):
    f4.tempo += dt
    if f4.msgT > 0:
        f4.msgT -= dt
    if f4.risadaT > 0:
        f4.risadaT -= dt
    else:
        f4.risada = None

    # ------- andar -------
    d = _direcao_atual()
    f4.andando = False
    if d:
        f4.dir = d.nome
        f4.x, f4.y, f4.andando = andarContornando(f4.x, f4.y, d, CONFIG["velRecreio"] * dt, livreNoPatio)
    f4.anim = f4.anim + dt * 8 if f4.andando else 0.0

    # ------- espiar -------
    if foiApertada("Space"):
        alvo_l, dist = None, float("inf")
        for l in f4.locais:
            dd = distAte(l)
            if dd < dist:
                dist = dd
                alvo_l = l
        if not alvo_l or dist > CONFIG["alcanceEspiar"]:
            msgF4("CHEGA MAIS PERTO DE UM ESCONDERIJO!")
        elif alvo_l.espiado:
            msgF4("JÁ OLHEI AQUI!")
        else:
            alvo_l.espiado = True
            if alvo_l.amigo >= 0:
                f4.achados += 1
                jogo.pontos += 250
                SFX.item()
                msgF4("ACHOU O " + AMIGOS[alvo_l.amigo]["nome"] + "!", 2.2)
                if f4.achados == len(AMIGOS):
                    jogo.pontos += 400
                    mostrarTransicao(
                        "ACHOU TODO MUNDO!",
                        "O RECREIO ACABOU E A AULA TAMBÉM!",
                        "A " + CONFIG["nomeTia"] + " JÁ TÁ NO PORTÃO PRA BUSCAR!",
                        lambda: iniciarFase1(True),
                    )
                    return
            else:
                SFX.porta()
                msgF4("NINGUÉM AQUI!")

    # ------- risadinha -------
    f4.tRisada -= dt
    if f4.tRisada <= 0:
        local, _dist = pistaAtual()
        f4.tRisada = CONFIG["intervaloRisada"]
        if local:
            f4.risada = local
            f4.risadaT = 1.1
            SFX.coleta()

def desenharRecreio():
    ret("#3d7a49", 0, PATIO_Y, W, H - PATIO_Y)
    for y in range(PATIO_Y, H, 26):
        ret("#357040", 0, y, W, 3)
    ret("#a9a897", 150, 150, 200, 130)
    ret_borda("#e8e8e8", 160, 160, 180, 110, 2)
    circulo("#e8e8e8", 250, 215, 26, 2)

    ret("#c0b492", 0, PATIO_Y, W, 22)
    ret("#a8402f", 0, PATIO_Y, W, 6)

    for l in f4.locais:
        e = l.ref
        spriteC(SPR[e["spr"]], e["x"], e["y"], e["esc"])
        if l.espiado:
            cor = "#3fa34d" if l.amigo >= 0 else "#d9463c"
            r = 12
            linha(cor, e["x"] - r, e["y"] - r, e["x"] + r, e["y"] + r, 3)
            linha(cor, e["x"] + r, e["y"] - r, e["x"] - r, e["y"] + r, 3)
        if l.espiado and l.amigo >= 0:
            spriteC(SPR["tutiBaixo0"], e["x"] + 26, e["y"] + 10, 2, AMIGOS[l.amigo]["cor"])
        if f4.risada is l and f4.risadaT > 0:
            painel(e["x"] - 26, e["y"] - 44, 52, 20, "#f7c948")
            texto("HIHI!", e["x"], e["y"] - 40, 11, "#f7c948")

    q = int(f4.anim) % 2
    esp = False
    if f4.dir == "cima":
        spr = SPR["tutiCima1"] if q else SPR["tutiCima0"]
    elif f4.dir == "baixo":
        spr = SPR["tutiBaixo1"] if q else SPR["tutiBaixo0"]
    else:
        spr = SPR["tutiLado1"] if q else SPR["tutiLado0"]
        esp = f4.dir == "esq"
    spriteC(spr, f4.x, f4.y, 2, None, esp)

    perto, dp = None, float("inf")
    for l in f4.locais:
        dd = distAte(l)
        if dd < dp:
            dp = dd
            perto = l
    if perto and dp <= CONFIG["alcanceEspiar"] and not perto.espiado:
        painel(f4.x - 46, f4.y - 46, 92, 22, "#f7c948")
        texto(txAcao() + "!", f4.x, f4.y - 42, 12, "#f7c948")

    if f4.msgT > 0:
        lt = medir(f4.msg, 14) + 24
        painel(W / 2 - lt / 2, 300, lt, 26)
        texto(f4.msg, W / 2, 305, 14, "#f7c948")

    desenharHudRecreio()

def desenharHudRecreio():
    painel(0, 0, W, HUD_H)
    texto("ESCONDE-ESCONDE", 10, 5, 10, "#f3c39a", "left")
    texto("ACHOU %d/%d" % (f4.achados, len(AMIGOS)), 10, 18, 17, "#f7c948", "left")

    _local, dist = pistaAtual()
    pista = PISTAS[0]
    for q in PISTAS:
        if dist <= q["d"]:
            pista = q
    texto("TÁ PERTO?", 196, 5, 10, "#f3c39a", "left")
    texto(pista["txt"], 196, 18, 16, pista["cor"], "left")

    for i in range(len(AMIGOS)):
        achado = any(l.espiado and l.amigo == i for l in f4.locais)
        sprite(SPR["carinha"], 400 + i * 22, 16, 2, AMIGOS[i]["cor"] if achado else CINZA)


# ==========================================================================
# FASE 6 — PEGA-PEGA NO QUINTAL DE CASA
# ==========================================================================
QUINTAL_Y = 46
MOVEIS = [
    dict(spr="arvore", x=76, y=166, esc=5),
    dict(spr="casinhaCao", x=404, y=150, esc=4),
    dict(spr="piscina", x=250, y=234, esc=5),
    dict(spr="arbusto", x=70, y=300, esc=4),
    dict(spr="arvore", x=410, y=294, esc=5),
]

f6 = NS()

def iniciarQuintal():
    abrirFase("FASE 6 — PEGA-PEGA NO QUINTAL", iniciarQuintal)
    f6.x = 240.0
    f6.y = 300.0
    f6.dir = "cima"
    f6.anim = 0.0
    f6.andando = False
    f6.tempo = 0.0
    f6.msg = ""
    f6.msgT = 0.0
    sorte = lambda: (random.random() - 0.5) * 70

    f6.fugitivos = [
        NS(nome=CONFIG["nomeIrmao"], spr="thomas", vel=CONFIG["velThomas"],
           x=150 + sorte(), y=130 + sorte(), pego=False, descanso=0.0, tDescanso=99.0,
           anim=0.0, dir=1, esperto=False, ulDx=None, ulDy=None),
        NS(nome=CONFIG["nomeTia"], spr="nuna", vel=CONFIG["velNunaFuga"],
           x=350 + sorte(), y=250 + sorte(), pego=False,
           descanso=0.0, tDescanso=CONFIG["descansoNuna"] + random.random() * 2,
           anim=0.0, dir=-1, esperto=True, ulDx=None, ulDy=None),
    ]
    trocarEstado("QUINTAL")

def msgF6(txt, dur=1.8):
    f6.msg = txt
    f6.msgT = dur

def livreNoQuintal(px, py):
    if px < 26 or px > W - 26 or py < QUINTAL_Y + 26 or py > H - 20:
        return False
    for m in MOVEIS:
        lw = larg(SPR[m["spr"]]) * m["esc"] / 2
        lh = len(SPR[m["spr"]]) * m["esc"] / 2
        if abs(px - m["x"]) < lw - 4 and abs(py - m["y"]) < lh - 4:
            return False
    return True

def atualizarQuintal(dt):
    f6.tempo += dt
    if f6.msgT > 0:
        f6.msgT -= dt

    # ------- o Tuti corre atrás -------
    d = _direcao_atual()
    f6.andando = False
    if d:
        f6.dir = d.nome
        f6.x, f6.y, f6.andando = andarContornando(f6.x, f6.y, d, CONFIG["velPegador"] * dt, livreNoQuintal)
    f6.anim = f6.anim + dt * 8 if f6.andando else 0.0

    # ------- quem foge -------
    for g in f6.fugitivos:
        if g.pego:
            continue

        g.tDescanso -= dt
        if g.tDescanso <= 0:
            g.descanso = CONFIG["descansoDur"]
            g.tDescanso = CONFIG["descansoNuna"] + 2
            if g.esperto:
                msgF6("A " + CONFIG["nomeTia"] + " PAROU! CORRE!", CONFIG["descansoDur"])
        if g.descanso > 0:
            g.descanso -= dt
            g.anim = 0.0
        else:
            v = g.vel * dt
            olhada = v * 8
            melhorX, melhorY, melhorNota = 0.0, 0.0, -float("inf")
            for a in range(16):
                ang = (a / 16) * math.pi * 2
                dx, dy = math.cos(ang), math.sin(ang)
                nx, ny = g.x + dx * olhada, g.y + dy * olhada
                if not livreNoQuintal(nx, ny):
                    continue
                nota = math.hypot(nx - f6.x, ny - f6.y)
                folga = min(nx - 26, W - 26 - nx, ny - (QUINTAL_Y + 26), H - 20 - ny)
                nota += min(folga, 100) * 0.9
                if g.ulDx is not None:
                    nota += (dx * g.ulDx + dy * g.ulDy) * 12
                if nota > melhorNota:
                    melhorNota = nota
                    melhorX, melhorY = dx, dy
            g.ulDx, g.ulDy = melhorX, melhorY
            if livreNoQuintal(g.x + melhorX * v, g.y):
                g.x += melhorX * v
            if livreNoQuintal(g.x, g.y + melhorY * v):
                g.y += melhorY * v
            if melhorX != 0:
                g.dir = -1 if melhorX < 0 else 1
            g.anim += dt * 9

        # pegou?
        if math.hypot(g.x - f6.x, g.y - f6.y) < 24:
            g.pego = True
            jogo.pontos += 400
            SFX.item()
            msgF6("PEGOU " + ("A " if g.nome == CONFIG["nomeTia"] else "O ") + g.nome + "!", 2.2)

    if all(g.pego for g in f6.fugitivos):
        jogo.pontos += 800 + max(0, round((60 - f6.tempo) * 20))
        mostrarTransicao(
            "PEGOU TODO MUNDO!",
            "O DIA FOI LONGO E JÁ ANOITECEU...",
            "AGORA UM DESENHO NA SALA ANTES DE DORMIR!",
            iniciarSala,
        )

def desenharQuintal():
    ret("#7bb661", 0, QUINTAL_Y, W, H - QUINTAL_Y)
    for y in range(QUINTAL_Y, H, 22):
        ret("#6da555", 0, y, W, 3)

    ret("#d9cfae", 0, QUINTAL_Y, W, 26)
    ret("#5b3a1a", 200, QUINTAL_Y + 6, 40, 20)
    for x in range(4, W, 22):
        ret("#8b5a2b", x, H - 16, 12, 16)
    ret("#8b5a2b", 0, H - 20, W, 5)

    # varal
    ret("#c8c2ad", 60, 88, 330, 3)
    roupas = ["#f2a3c7", "#7fc4ff", "#f7c948", "#ffffff"]
    for i in range(4):
        ret(roupas[i], 96 + i * 74, 91, 26, 22 + (i % 2) * 6)

    for m in MOVEIS:
        spriteC(SPR[m["spr"]], m["x"], m["y"], m["esc"])

    for g in f6.fugitivos:
        if g.pego:
            spr = SPR["nuna"] if g.spr == "nuna" else SPR["thomasBaixo0"]
            spriteC(spr, g.x, g.y + 6, 2, {"S": "#f3c39a"})
            painel(g.x - 30, g.y - 40, 60, 20, "#f2a3c7")
            texto("HAHA!", g.x, g.y - 36, 11, "#f2a3c7")
        else:
            q = int(g.anim) % 2
            if g.spr == "nuna":
                spriteC(SPR["nuna"], g.x, g.y, 2, None, g.dir < 0)
            else:
                spriteC(SPR["thomasBaixo1"] if q else SPR["thomasBaixo0"], g.x, g.y, 2, None, g.dir < 0)
            if g.descanso > 0:
                painel(g.x - 26, g.y - 44, 52, 20, "#f7c948")
                texto("UFA!", g.x, g.y - 40, 11, "#f7c948")

    q = int(f6.anim) % 2
    esp = False
    if f6.dir == "cima":
        spr = SPR["tutiCima1"] if q else SPR["tutiCima0"]
    elif f6.dir == "baixo":
        spr = SPR["tutiBaixo1"] if q else SPR["tutiBaixo0"]
    else:
        spr = SPR["tutiLado1"] if q else SPR["tutiLado0"]
        esp = f6.dir == "esq"
    spriteC(spr, f6.x, f6.y, 2, None, esp)

    if f6.msgT > 0:
        lt = medir(f6.msg, 14) + 24
        painel(W / 2 - lt / 2, 300, lt, 26)
        texto(f6.msg, W / 2, 305, 14, "#f7c948")

    painel(0, 0, W, HUD_H)
    texto("PEGA-PEGA!", 10, 5, 10, "#f3c39a", "left")
    texto("VOCÊ É O PEGADOR", 10, 18, 15, "#f7c948", "left")
    for i, g in enumerate(f6.fugitivos):
        x = 236 + i * 118
        ret_alpha((63, 163, 77, 90) if g.pego else (255, 255, 255, 20), x - 4, 8, 112, 28)
        texto("PEGOU!" if g.pego else g.nome, x + 52, 15, 12, "#3fa34d" if g.pego else "#ffffff")
    texto("%.1fs" % f6.tempo, 470, 4, 12, "#c8c2ad", "right")

# ==========================================================================
# FASE 7 — A NOITE NA SALA DE CASA
# ==========================================================================
PAREDE_Y = 300
PISO = 318
TV = NS(x=60, y=150, w=128, h=100, sx=68, sy=158, sw=112, sh=76)
SOFA = NS(x=284, y=256, w=176)

def mgBase():
    return NS(t=0.0, coletados=0, invenc=0.0, brilhos=[], opaT=0.0, opaX=0.0, opaY=0.0)

def mgVolta(v, n):
    return ((v % n) + n) % n

def mgFundo(cima, baixo):
    gradiente_v(0, 0, MG_W, MG_H, ((0.0, cima), (1.0, baixo)))

def mgPegou(m, x, y):
    m.coletados += 1
    jogo.pontos += 60
    m.brilhos.append(NS(x=x, y=y, t=0.45))
    SFX.item()

def mgOpa(m, x, y):
    if m.invenc > 0 or m.t < 1.2:
        return False
    m.invenc = 1.1
    m.opaX, m.opaY, m.opaT = x, y, 0.9
    jogo.pontos = max(0, jogo.pontos - 30)
    SFX.dano()
    tremer(0.3)
    return True

def mgAtualizarEfeitos(m, dt):
    m.t += dt
    m.invenc = max(0.0, m.invenc - dt)
    if m.opaT > 0:
        m.opaT -= dt
    for b in m.brilhos:
        b.t -= dt
    m.brilhos = [b for b in m.brilhos if b.t > 0]

def mgDesenharEfeitos(m):
    for b in m.brilhos:
        r = 8 + (0.45 - b.t) * 40
        ret_borda("#f7c948", b.x - r, b.y - r, r * 2, r * 2, 3)
    if m.opaT > 0:
        lw = medir("OPA!", 20) + 20
        painel(m.opaX - lw / 2, m.opaY - 52, lw, 28, "#d9463c")
        texto("OPA!", m.opaX, m.opaY - 47, 20, "#d9463c")

# ---------------- 1) O FOGUETE ----------------
def capa_foguete(x, y, w, h):
    ret("#101936", x, y, w, h)
    for i in range(16):
        ret("#ffffff" if i % 3 else "#f7c948",
            x + int((i * 43 + i * i * 7) % w), y + int((i * 29 + i * i * 3) % h), 2, 2)
    circulo("#e8e2c8", x + w - 14, y + 12, 7)
    circulo("#101936", x + w - 17, y + 10, 6)
    spriteC(SPR["foguete"], x + w / 2, y + h / 2 + math.sin(jogo.t * 3) * 3, max(2, round(h / 24)))

def iniciar_foguete(m):
    m.x = MG_W / 2
    m.coisas = []
    m.tMeteoro = 0.9
    m.tEstrela = 0.5
    m.estrelinhas = [NS(x=random.random() * MG_W, y=random.random() * MG_H,
                        v=30 + random.random() * 80) for _ in range(44)]

def atualizar_foguete(m, dt):
    if teclas.get("ArrowLeft"):
        m.x -= CONFIG["velFoguete"] * dt
    if teclas.get("ArrowRight"):
        m.x += CONFIG["velFoguete"] * dt
    m.x = max(26, min(MG_W - 26, m.x))
    y = MG_H - 52

    for e in m.estrelinhas:
        e.y += e.v * dt
        if e.y > MG_H:
            e.y = 0
            e.x = random.random() * MG_W

    m.tMeteoro -= dt
    m.tEstrela -= dt
    if m.tMeteoro <= 0:
        m.coisas.append(NS(tipo="meteoro", x=34 + random.random() * (MG_W - 68), y=-24.0,
                           v=145 + random.random() * 70, pego=False))
        m.tMeteoro = 0.72 + random.random() * 0.45
    if m.tEstrela <= 0:
        m.coisas.append(NS(tipo="estrela", x=34 + random.random() * (MG_W - 68), y=-24.0,
                           v=120, pego=False))
        m.tEstrela = 0.85 + random.random() * 0.7

    for c in m.coisas:
        c.y += c.v * dt
        if c.pego:
            continue
        d = math.hypot(c.x - m.x, c.y - y)
        if c.tipo == "estrela":
            if d < 32:
                c.pego = True
                mgPegou(m, c.x, c.y)
        elif d < 28 and mgOpa(m, c.x, c.y):
            c.pego = True
    m.coisas = [c for c in m.coisas if not c.pego and c.y < MG_H + 40]

def desenhar_foguete(m):
    mgFundo("#0b1030", "#2a2350")
    for e in m.estrelinhas:
        ret("#ffffff", int(e.x), int(e.y), 2, 2)
    circulo("#e8e2c8", MG_W - 54, 44, 22)
    circulo("#0b1030", MG_W - 64, 40, 20)

    for c in m.coisas:
        if c.tipo == "estrela":
            spriteC(SPR["estrela"], c.x, c.y, 3)
        else:
            spriteC(SPR["meteoro"], c.x, c.y, 4)

    y = MG_H - 52
    for i in range(3):
        ret("#f7c948" if i % 2 else "#e8853a", m.x - 8 + random.random() * 16, y + 24 + i * 6, 5, 7)
    pisca = m.invenc > 0 and int(m.invenc * 12) % 2 == 0
    if not pisca:
        spriteC(SPR["foguete"], m.x, y, 4)
    mgDesenharEfeitos(m)

# ---------------- 2) OS DINOSSAUROS ----------------
def capa_dino(x, y, w, h):
    ret("#e8853a", x, y, w, h)
    ret("#d9463c", x, y, w, h * 0.42)
    poligono("#8a4a3a", [(x + w - 52, y + h - 12), (x + w - 26, y + h * 0.24), (x + w, y + h - 12)])
    ret("#3fa34d", x, y + h - 12, w, 12)
    ret("#276b32", x, y + h - 12, w, 3)
    spriteC(SPR["dino"], x + w / 2 - 6, y + h - 24, max(1, round(h / 26)))

def iniciar_dino(m):
    m.y = 0.0
    m.vy = 0.0
    m.noChao = True
    m.obst = []
    m.tObst = 1.2
    m.rolagem = 0.0
    m.tropeco = 0.0
    m.montanhas = [NS(x=i * 130, alt=46 + random.random() * 54, vulcao=i == 2) for i in range(5)]

def atualizar_dino(m, dt):
    CHAO = MG_H - 46
    m.rolagem += CONFIG["velChaoDino"] * dt

    if (foiApertada("ArrowUp") or foiApertada("Space")) and m.noChao:
        m.vy = -CONFIG["puloDino"]
        m.noChao = False
        SFX.turbo()
    m.vy += CONFIG["gravidadeDino"] * dt
    m.y += m.vy * dt
    if m.y > 0:
        m.y = 0.0
        m.vy = 0.0
        m.noChao = True
    if m.tropeco > 0:
        m.tropeco -= dt

    m.tObst -= dt
    if m.tObst <= 0:
        fruta = random.random() < 0.45
        m.obst.append(NS(tipo="fruta" if fruta else "pedra", x=MG_W + 30.0,
                         y=CHAO - 74.0 if fruta else CHAO - 14.0, pego=False))
        m.tObst = 0.9 + random.random() * 0.7

    dinoX, dinoY = 96, CHAO + m.y - 24
    for o in m.obst:
        o.x -= CONFIG["velChaoDino"] * dt
        if o.pego:
            continue
        if abs(o.x - dinoX) < 28 and abs(o.y - dinoY) < 30:
            if o.tipo == "fruta":
                o.pego = True
                mgPegou(m, o.x, o.y)
            elif mgOpa(m, o.x, o.y):
                o.pego = True
                m.tropeco = 0.5
    m.obst = [o for o in m.obst if not o.pego and o.x > -40]

def desenhar_dino(m):
    CHAO = MG_H - 46
    mgFundo("#d9463c", "#f0a05a")
    for mo in m.montanhas:
        x = mgVolta(mo.x - m.rolagem * 0.25, MG_W + 200) - 100
        poligono("#8a4a3a", [(x - 60, CHAO), (x, CHAO - mo.alt), (x + 60, CHAO)])
        if mo.vulcao:
            ret("#f7c948", x - 7, CHAO - mo.alt, 14, 10)
            for i in range(3):
                s = (m.t * 18 + i * 16) % 48
                ret_alpha((200, 194, 173, 128), x - 6 + math.sin(s / 8) * 6, CHAO - mo.alt - 8 - s, 9, 9)
    ret("#8b5a2b", 0, CHAO, MG_W, MG_H - CHAO)
    ret("#3fa34d", 0, CHAO, MG_W, 8)
    for i in range(12):
        x = mgVolta(i * 60 - m.rolagem, MG_W + 60) - 30
        ret("#276b32", x, CHAO + 2, 16, 4)

    for o in m.obst:
        if o.tipo == "fruta":
            spriteC(SPR["banana"], o.x, o.y, 4)
        else:
            spriteC(SPR["pedra"], o.x, o.y, 4)

    dinoY = CHAO + m.y - 24
    pisca = m.invenc > 0 and int(m.invenc * 12) % 2 == 0
    if not pisca:
        tomba = math.sin(m.t * 40) * 4 if m.tropeco > 0 else 0
        spriteC(SPR["dino"], 96 + tomba, dinoY, 4)
    mgDesenharEfeitos(m)

# ---------------- 3) O FUNDO DO MAR ----------------
def capa_mar(x, y, w, h):
    ret("#3f6fd1", x, y, w, h)
    ret("#7fc4ff", x, y, w, h * 0.35)
    ret("#c2a06a", x, y + h - 10, w, 10)
    ret("#3fa34d", x + 8, y + h - 24, 5, 16)
    ret("#3fa34d", x + w - 16, y + h - 28, 5, 20)
    spriteC(SPR["peixe"], x + w / 2 + 16, y + h / 2, max(1, round(h / 30)))
    spriteC(SPR["mergulhador"], x + w / 2 - 16, y + h / 2, max(1, round(h / 24)))

def iniciar_mar(m):
    m.x = MG_W / 2
    m.y = MG_H / 2
    m.dir = 1
    m.peixes = []
    m.tPeixe = 0.4
    m.aguas = []
    cantos = [(90, 66), (256, 216), (382, 104)]
    for i, (ax, ay) in enumerate(cantos):
        m.aguas.append(NS(x=float(ax), y=float(ay),
                          vx=(1 if i % 2 else -1) * (44 + i * 8),
                          vy=(-1 if i % 2 else 1) * (32 + i * 6)))
    m.bolhas = [NS(x=random.random() * MG_W, y=random.random() * MG_H,
                   v=22 + random.random() * 45, r=2 + random.random() * 3) for _ in range(20)]

def atualizar_mar(m, dt):
    v = CONFIG["velMergulho"] * dt
    if teclas.get("ArrowLeft"):
        m.x -= v
        m.dir = -1
    if teclas.get("ArrowRight"):
        m.x += v
        m.dir = 1
    if teclas.get("ArrowUp"):
        m.y -= v
    if teclas.get("ArrowDown"):
        m.y += v
    m.x = max(26, min(MG_W - 26, m.x))
    m.y = max(26, min(MG_H - 42, m.y))

    for b in m.bolhas:
        b.y -= b.v * dt
        if b.y < 0:
            b.y = MG_H
            b.x = random.random() * MG_W

    m.tPeixe -= dt
    if m.tPeixe <= 0:
        daEsquerda = random.random() < 0.5
        m.peixes.append(NS(
            x=-24.0 if daEsquerda else MG_W + 24.0,
            y=40 + random.random() * (MG_H - 100),
            v=(1 if daEsquerda else -1) * (75 + random.random() * 55),
            pego=False))
        m.tPeixe = 0.7 + random.random() * 0.6
    for p in m.peixes:
        p.x += p.v * dt
        if not p.pego and math.hypot(p.x - m.x, p.y - m.y) < 28:
            p.pego = True
            mgPegou(m, p.x, p.y)
    m.peixes = [p for p in m.peixes if not p.pego and -50 < p.x < MG_W + 50]

    for a in m.aguas:
        a.x += a.vx * dt
        a.y += a.vy * dt
        if a.x < 28 or a.x > MG_W - 28:
            a.vx *= -1
        if a.y < 28 or a.y > MG_H - 52:
            a.vy *= -1
        if math.hypot(a.x - m.x, a.y - m.y) < 28:
            mgOpa(m, a.x, a.y)

def desenhar_mar(m):
    mgFundo("#3f6fd1", "#0e2a55")
    for b in m.bolhas:
        ret_alpha((127, 196, 255, 64), int(b.x), int(b.y), int(b.r), int(b.r))

    ret("#c2a06a", 0, MG_H - 26, MG_W, 26)
    for i in range(9):
        x = 24 + i * 52
        gomos = 4 + ((i * 7) % 4)
        for g in range(gomos):
            p = g / gomos
            ret("#3fa34d" if g % 2 else "#276b32",
                x + math.sin(m.t * 2 + i + g * 0.6) * (3 + p * 7), MG_H - 30 - g * 9, 6, 10)

    for p in m.peixes:
        spriteC(SPR["peixe"], p.x, p.y, 3, None, p.v > 0)
    for a in m.aguas:
        flut = math.sin(m.t * 3 + a.x) * 3
        spriteC(SPR["aguaViva"], a.x, a.y + flut, 4)

    pisca = m.invenc > 0 and int(m.invenc * 12) % 2 == 0
    if not pisca:
        spriteC(SPR["mergulhador"], m.x, m.y, 4, None, m.dir < 0)
    mgDesenharEfeitos(m)

DESENHOS = [
    dict(nome="O FOGUETE", dica="← → DESVIA DOS METEOROS E PEGA AS ESTRELAS",
         capa=capa_foguete, iniciar=iniciar_foguete,
         atualizar=atualizar_foguete, desenhar=desenhar_foguete),
    dict(nome="OS DINOSSAUROS", dica="↑ OU %A PRA PULAR AS PEDRAS",
         capa=capa_dino, iniciar=iniciar_dino,
         atualizar=atualizar_dino, desenhar=desenhar_dino),
    dict(nome="O FUNDO DO MAR", dica="SETAS PRA NADAR, FUJA DAS ÁGUAS-VIVAS",
         capa=capa_mar, iniciar=iniciar_mar,
         atualizar=atualizar_mar, desenhar=desenhar_mar),
]

f7 = NS()

def iniciarSala():
    abrirFase("FASE 7 — A NOITE NA SALA", iniciarSala)
    f7.etapa = 0
    f7.tt = 0.0
    f7.msg = ""
    f7.msgT = 0.0

    f7.desenho = 0
    f7.mini = None
    f7.zoom = 0.0
    f7.saindo = False
    f7.sono = 0.0

    f7.tutiX = 232.0
    f7.olhando = -1
    f7.andando = False
    f7.pertoSofa = False

    f7.deitado = False
    f7.nunaX = -50.0
    f7.coberto = False
    f7.luz = 0.0
    f7.tvLigada = True
    trocarEstado("SALA")

def msgF7(txt, dur=1.8):
    f7.msg = txt
    f7.msgT = dur

def atualizarSala(dt):
    f7.tt += dt
    if f7.msgT > 0:
        f7.msgT -= dt

    if f7.etapa == 0:
        # ---- ESCOLHER ----
        if foiApertada("ArrowRight"):
            f7.desenho = (f7.desenho + 1) % len(DESENHOS)
            SFX.coleta()
        if foiApertada("ArrowLeft"):
            f7.desenho = (f7.desenho + len(DESENHOS) - 1) % len(DESENHOS)
            SFX.coleta()
        if foiApertada("Space"):
            f7.mini = mgBase()
            DESENHOS[f7.desenho]["iniciar"](f7.mini)
            f7.etapa = 1
            f7.zoom = 0.0
            f7.saindo = False
            f7.sono = 0.0
            SFX.fase()
            msgF7("COMEÇOU " + DESENHOS[f7.desenho]["nome"] + "!", 2)

    elif f7.etapa == 1:
        # ---- DENTRO DO DESENHO ----
        if f7.saindo:
            f7.zoom = max(0.0, f7.zoom - dt / 0.5)
            if f7.zoom <= 0:
                f7.etapa = 2
                f7.tt = 0.0
                msgF7("QUE SONO...", 2.4)
            return
        if f7.zoom < 1:
            f7.zoom = min(1.0, f7.zoom + dt / 0.5)
            return

        mgAtualizarEfeitos(f7.mini, dt)
        DESENHOS[f7.desenho]["atualizar"](f7.mini, dt)
        f7.sono = min(100.0, f7.sono + (100 / CONFIG["duracaoEpisodio"]) * dt)
        if f7.sono >= 100:
            f7.saindo = True
            jogo.pontos += 300
            SFX.fase()
            msgF7("FIM DO EPISÓDIO!", 2.2)

    elif f7.etapa == 2:
        # ---- ANDAR ATÉ O SOFÁ ----
        v = CONFIG["velQuarto"] * dt
        if teclas.get("ArrowLeft"):
            f7.tutiX -= v
            f7.olhando = -1
        if teclas.get("ArrowRight"):
            f7.tutiX += v
            f7.olhando = 1
        f7.tutiX = max(60, min(430, f7.tutiX))
        f7.andando = bool(teclas.get("ArrowLeft") or teclas.get("ArrowRight"))

        f7.pertoSofa = abs(f7.tutiX - (SOFA.x + SOFA.w / 2)) < 70
        if f7.pertoSofa and foiApertada("Space"):
            f7.deitado = True
            f7.etapa = 3
            f7.tt = 0.0
            SFX.fase()

    else:
        # ---- A TIA COBRE ELE E APAGA A LUZ ----
        if f7.tt > 1.2 and not f7.coberto:
            f7.nunaX = min(252.0, f7.nunaX + 78 * dt)
        if f7.nunaX >= 252 and not f7.coberto:
            f7.coberto = True
            jogo.pontos += 500
            SFX.item()
            msgF7("BOA NOITE, " + CONFIG["nomeMenino"] + "!", 3.2)
        if f7.coberto:
            f7.luz = min(1.0, f7.luz + dt * 0.45)
            if f7.luz > 0.3:
                f7.tvLigada = False
        if f7.luz >= 1 and (foiApertada("Space") or f7.tt > 12):
            jogo.pontos += 1000
            SFX.vitoria()
            criarConfete()
            trocarEstado("VITORIA")

# ---------- desenho da sala ----------
_scanlines = None

def _pegar_scanlines():
    global _scanlines
    if _scanlines is None:
        _scanlines = pygame.Surface((MG_W, MG_H), pygame.SRCALPHA)
        for ly in range(0, MG_H, 5):
            _scanlines.fill((0, 0, 0, 26), (0, ly, MG_W, 2))
    return _scanlines

def desenharDesenhoEmTela(p):
    global alvo
    x = TV.sx + (16 - TV.sx) * p
    y = TV.sy + (56 - TV.sy) * p
    w = TV.sw + (MG_W - TV.sw) * p
    h = TV.sh + (MG_H - TV.sh) * p

    # o joguinho desenha em coordenadas locais numa superfície própria,
    # que depois é escalada — o mesmo truque do ctx.scale() original
    alvo = mg_surf
    DESENHOS[f7.desenho]["desenhar"](f7.mini)
    alvo.blit(_pegar_scanlines(), (0, 0))
    alvo = tela

    escalado = pygame.transform.scale(mg_surf, (max(1, int(w)), max(1, int(h))))
    tela.blit(escalado, (int(x), int(y)))

    ret_borda("#12131a", x - 3, y - 3, w + 6, h + 6, 6)
    ret_borda("#5d6272", x - 5, y - 5, w + 10, h + 10, 2)

def desenharMenuDesenhos():
    painel(24, 50, 432, 96, "#f7c948")
    texto("QUAL DESENHO VOCÊ QUER VER?", W / 2, 54, 11, "#f7c948")

    for i, d in enumerate(DESENHOS):
        cx0, cy0, cw, ch = 108 + i * 132, 72, 108, 44
        sel = i == f7.desenho
        ret("#f7c948" if sel else "#3a3f4c", cx0 - cw / 2 - 3, cy0 - 3, cw + 6, ch + 20)
        d["capa"](cx0 - cw / 2, cy0, cw, ch)
        texto(d["nome"], cx0, cy0 + ch + 3, 9, "#12131a" if sel else "#c8c2ad", "center", None)
        if sel and int(jogo.t * 5) % 2 == 0:
            ret("#f7c948", cx0 - cw / 2 - 14, cy0 + ch / 2 - 3, 8, 8)
            ret("#f7c948", cx0 + cw / 2 + 6, cy0 + ch / 2 - 3, 8, 8)

def desenharTV():
    ret("#4a3b52", 108, 250, 32, 58)
    ret("#5b3a1a", 76, 308, 96, 10)
    ret("#3a3f4c", TV.x, TV.y, TV.w, TV.h)
    ret("#12131a", TV.x + 4, TV.y + 4, TV.w - 8, TV.h - 8)

    alvo.set_clip(pygame.Rect(TV.sx, TV.sy, TV.sw, TV.sh))
    if f7.tvLigada:
        DESENHOS[f7.desenho]["capa"](TV.sx, TV.sy, TV.sw, TV.sh)
    else:
        ret("#1b1d26", TV.sx, TV.sy, TV.sw, TV.sh)
    alvo.set_clip(None)

    ret("#3fa34d" if f7.tvLigada else "#5d6272", TV.x + TV.w - 16, TV.y + TV.h - 12, 6, 6)

SOFA_ASSENTO = 290

def desenharSofa():
    s = SOFA
    ret("#5c3f6b", s.x, s.y, s.w, 46)
    ret("#6f4d80", s.x + 12, s.y + 8, s.w - 24, 30)
    ret("#f2a3c7", s.x + s.w - 60, s.y + 10, 30, 26)
    ret("#6f4d80", s.x + 20, SOFA_ASSENTO, s.w - 40, 18)
    ret("#7d5990", s.x + 22, SOFA_ASSENTO + 2, s.w - 44, 3)
    ret("#5c3f6b", s.x, 282, 22, PISO - 282)
    ret("#5c3f6b", s.x + s.w - 22, 282, 22, PISO - 282)
    ret("#4b3358", s.x + 20, 308, s.w - 40, PISO - 308)

def desenharSala():
    ret("#6e5a7a", 0, HUD_H, W, PAREDE_Y - HUD_H)
    for x in range(0, W, 30):
        ret("#65526f", x, HUD_H, 3, PAREDE_Y - HUD_H)
    ret("#4a3b52", 0, PAREDE_Y - 8, W, 8)
    ret("#8b5a2b", 0, PAREDE_Y, W, H - PAREDE_Y)
    for x in range(0, W, 44):
        ret("#6b421d", x, PAREDE_Y, 2, H - PAREDE_Y)
    ret("#a8402f", 92, 326, 232, 28)
    ret("#d9463c", 98, 330, 220, 20)
    ret("#f7c948", 112, 338, 192, 4)

    # janela da noite
    ret("#5b3a1a", 322, 88, 100, 72)
    ret("#101936", 328, 94, 88, 60)
    for i in range(10):
        ret("#f7c948", 330 + (i * 31) % 84, 96 + (i * 17) % 54, 2, 2)
    ret("#fff2b0", 392, 100, 14, 14)
    ret("#101936", 388, 100, 8, 14)
    ret("#5b3a1a", 370, 94, 4, 60)
    ret("#5b3a1a", 328, 120, 88, 4)

    # quadrinho
    ret("#8b5a2b", 206, 108, 62, 50)
    ret("#e8dcc0", 210, 112, 54, 42)
    sprite(SPR["carinha"], 218, 122, 3, {"H": "#7a4a24"})
    sprite(SPR["coracao"], 244, 126, 2)

    desenharTV()
    desenharSofa()

    if f7.deitado:
        cabeca, corpoX = SOFA.x + 40, SOFA.x + 62
        if f7.coberto:
            ret("#3f6fd1", corpoX, SOFA_ASSENTO - 24, 84, 24)
            ret("#7fc4ff", corpoX, SOFA_ASSENTO - 24, 84, 6)
            ret("#2b4f9e", corpoX, SOFA_ASSENTO - 9, 84, 4)
        else:
            ret("#3fa34d", corpoX, SOFA_ASSENTO - 22, 46, 22)
            ret("#223a72", corpoX + 42, SOFA_ASSENTO - 19, 32, 19)
            ret("#12131a", corpoX + 72, SOFA_ASSENTO - 16, 12, 16)
        spriteC(SPR["tutiDormindo"], cabeca, SOFA_ASSENTO - 16, 4)
        for i in range(3):
            p = (jogo.t * 0.6 + i / 3) % 1
            texto("Z", cabeca - 10 + p * 24, SOFA_ASSENTO - 36 - p * 46, 10 + i * 3, "#ffffff")
    else:
        q = int(jogo.t * 8) % 2 if f7.andando else 0
        olhoMole = {"k": "#a97e52"} if f7.etapa == 2 else None
        spriteC(SPR["tutiLado1"] if q else SPR["tutiLado0"], f7.tutiX, PISO - 34, 4, olhoMole, f7.olhando == -1)
        if f7.etapa == 0:
            spriteC(SPR["controle"], f7.tutiX - 24, PISO - 36, 3)

    if f7.etapa == 3 and f7.nunaX > -40:
        spriteC(SPR["nuna"], f7.nunaX, PISO - 42, 4)
        if not f7.coberto:
            ret("#3f6fd1", f7.nunaX + 20, PISO - 52, 30, 20)
            ret("#7fc4ff", f7.nunaX + 20, PISO - 52, 30, 6)

    if f7.etapa == 0:
        desenharMenuDesenhos()

    if f7.etapa == 1:
        ret_alpha((9, 11, 20, int(153 * f7.zoom)), 0, 0, W, H)
        desenharDesenhoEmTela(f7.zoom)

    if f7.etapa == 2 and not f7.pertoSofa and int(jogo.t * 4) % 2 == 0:
        sx = SOFA.x + SOFA.w / 2
        ret("#f7c948", sx - 4, 186, 8, 12)
        ret("#f7c948", sx - 10, 198, 20, 6)
        ret("#f7c948", sx - 6, 204, 12, 5)
        ret("#f7c948", sx - 2, 209, 4, 4)
    if f7.etapa == 2 and f7.pertoSofa:
        painel(f7.tutiX - 52, PISO - 96, 104, 22, "#f7c948")
        texto(txAcao() + " = DEITAR", f7.tutiX, PISO - 92, 11, "#f7c948")

    if f7.luz > 0:
        ret_alpha((9, 11, 20, int(168 * f7.luz)), 0, 0, W, H)

    if f7.msgT > 0:
        lt = medir(f7.msg, 15) + 26
        painel(W / 2 - lt / 2, H - 40, lt, 28)
        texto(f7.msg, W / 2, H - 34, 15, "#f7c948")

    if f7.luz >= 1 and int(jogo.t * 2) % 2 == 0:
        painel(W / 2 - 130, 326, 260, 26)
        texto(txAcao() + " = FIM DA MISSÃO", W / 2, 331, 14, "#f7c948")

    desenharHudSala()

def desenharHudSala():
    painel(0, 0, W, HUD_H)
    d = DESENHOS[f7.desenho]
    titulos = ["ESCOLHE O DESENHO!", d["nome"], "BORA PRO SOFÁ!", "BOA NOITE!"]
    dicas = [
        "← → OLHA OS DESENHOS, " + txAcao() + " ESCOLHE",
        d["dica"].replace("%A", txAcao()),
        "← → ANDA, " + txAcao() + " DEITA NO SOFÁ",
        "DURMA BEM, " + CONFIG["nomeMenino"] + "!",
    ]
    texto("FASE 7 — A NOITE NA SALA", 10, 5, 10, "#f3c39a", "left")
    texto(titulos[f7.etapa], 10, 18, 15, "#f7c948", "left")
    texto(dicas[f7.etapa], 470, 5, 10, "#c8c2ad", "right")

    if f7.mini:
        texto("PEGOU: %d" % f7.mini.coletados, 178, 21, 12, "#f2a3c7", "left")
    if f7.etapa == 1:
        texto("SONO", 268, 22, 10, "#f3c39a", "left")
        barra(302, 20, 164, 16, f7.sono / 100, "#7fc4ff")


