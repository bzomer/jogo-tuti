def perderVida():
    jogo.vidas -= 1
    SFX.dano()
    tremer(0.4)
    if jogo.vidas <= 0:
        SFX.fim()
        trocarEstado("GAMEOVER")
        return True
    return False

# ==========================================================================
# MINI-FASE — A MANHÃ EM CASA
# ==========================================================================
TAREFAS = [
    dict(titulo="HORA DE ACORDAR!", dica="APERTE %A SEM PARAR!"),
    dict(titulo="CAFÉ DA MANHÃ!", dica="USE ← → PRA PEGAR A COMIDA"),
    dict(titulo="ESCOVAR OS DENTES!", dica="USE ← → PRA ESFREGAR"),
    dict(titulo="SE ARRUMAR PRA SAIR!", dica="← → PRA ANDAR, %A PRA VESTIR"),
]

ROUPAS = [
    dict(chave="camiseta", spr="camiseta", nome="CAMISETA", x=108),
    dict(chave="calca", spr="calca", nome="CALÇA", x=196),
    dict(chave="tenis", spr="tenis", nome="TÊNIS", x=284),
    dict(chave="mochila", spr="mochila", nome="MOCHILA", x=372),
]

COMIDAS = ["pao", "leite", "banana", "bolacha"]

f0 = NS()

def iniciarManha():
    f0.tarefa = -1
    f0.tt = 0.0
    f0.fim = 0.0
    f0.prog = 0.0
    f0.msg = ""
    f0.vestido = dict(camiseta=False, calca=False, tenis=False, mochila=False)
    f0.tutiX = 240.0
    f0.caindo = []
    f0.pegos = 0
    f0.tCai = 0.6
    f0.dentes = [1.0] * CONFIG["dentesQtd"]
    f0.escova = 240.0
    f0.espuma = []
    f0.pior = None
    f0.olhando = 1
    f0.andando = False
    f0.perto = None
    trocarEstado("MANHA")

def corTuti():
    v = f0.vestido if hasattr(f0, "vestido") else {}
    r = {}
    if not v.get("camiseta"):
        r["g"] = "#b9c2d6"
        r["G"] = "#8d97ad"
    if not v.get("calca"):
        r["A"] = "#d3d8e6"
    if not v.get("tenis"):
        r["S"] = "#f3c39a"
    if not v.get("mochila"):
        r["a"] = "#3fa34d" if v.get("camiseta") else "#b9c2d6"
    return r

def terminarTarefa(msg):
    f0.fim = 1.6
    f0.msg = msg
    SFX.fase()

def proximaTarefa():
    f0.tarefa += 1
    f0.tt = 0.0
    f0.fim = 0.0
    f0.prog = 0.0
    f0.msg = ""

def atualizarManha(dt):
    f0.tt += dt

    if f0.fim > 0:
        f0.fim -= dt
        if f0.fim <= 0:
            proximaTarefa()
        return

    if f0.tarefa == -1:
        if f0.tt > 0.5 and foiApertada("Space"):
            proximaTarefa()
        return
    if f0.tarefa >= len(TAREFAS):
        if f0.tt > 0.5 and foiApertada("Space"):
            iniciarFase1()
        return

    v = CONFIG["velQuarto"] * dt

    if f0.tarefa == 0:
        # ---- ACORDAR ----
        f0.prog = max(0.0, f0.prog - CONFIG["acordarQueda"] * dt)
        if foiApertada("Space"):
            f0.prog = min(100.0, f0.prog + CONFIG["acordarPorAperto"])
            SFX.coleta()
        if f0.prog >= 100:
            terminarTarefa("BOM DIA, " + CONFIG["nomeMenino"] + "!")

    elif f0.tarefa == 1:
        # ---- CAFÉ ----
        if teclas.get("ArrowLeft"):
            f0.tutiX -= v * 1.5
        if teclas.get("ArrowRight"):
            f0.tutiX += v * 1.5
        f0.tutiX = max(60, min(420, f0.tutiX))

        f0.tCai -= dt
        if f0.tCai <= 0 and f0.pegos + len(f0.caindo) < CONFIG["cafeMeta"]:
            f0.caindo.append(NS(
                x=70 + random.random() * 340,
                y=HUD_H - 20.0,
                tipo=random.choice(COMIDAS),
                pego=False,
            ))
            f0.tCai = CONFIG["cafeIntervalo"]
        for c in f0.caindo:
            c.y += CONFIG["cafeQueda"] * dt
            if (not c.pego) and 248 < c.y < 284 and abs(c.x - f0.tutiX) < 26:
                c.pego = True
                f0.pegos += 1
                jogo.pontos += 30
                SFX.item()
        f0.caindo = [c for c in f0.caindo if not c.pego and c.y < H + 20]
        f0.prog = f0.pegos / CONFIG["cafeMeta"] * 100
        if f0.pegos >= CONFIG["cafeMeta"]:
            terminarTarefa("QUE DELÍCIA!")

    elif f0.tarefa == 2:
        # ---- DENTES ----
        if teclas.get("ArrowLeft"):
            f0.escova -= CONFIG["velEscova"] * dt
        if teclas.get("ArrowRight"):
            f0.escova += CONFIG["velEscova"] * dt
        x0, larguraDente = 90, 300 / CONFIG["dentesQtd"]
        f0.escova = max(x0, min(x0 + 300, f0.escova))

        i = max(0, min(CONFIG["dentesQtd"] - 1, int((f0.escova - x0) / larguraDente)))
        antes = f0.dentes[i]
        f0.dentes[i] = max(0.0, f0.dentes[i] - CONFIG["dentesForca"] * dt)
        if antes > 0 and f0.dentes[i] < antes:
            for _n in range(2):
                f0.espuma.append(NS(
                    x=f0.escova + (random.random() - 0.5) * 24, y=178.0,
                    vx=(random.random() - 0.5) * 60, vy=-40 - random.random() * 45, vida=0.8,
                ))
        if antes > 0.02 and f0.dentes[i] <= 0.02:
            SFX.coleta()

        for e in f0.espuma:
            e.x += e.vx * dt
            e.y += e.vy * dt
            e.vy += 130 * dt
            e.vida -= dt
        f0.espuma = [e for e in f0.espuma if e.vida > 0]

        limpos = sum(1 for d in f0.dentes if d <= 0.02)
        f0.prog = limpos / CONFIG["dentesQtd"] * 100
        f0.pior = None
        melhorDist = float("inf")
        for n in range(len(f0.dentes)):
            if f0.dentes[n] <= 0.02:
                continue
            d = abs(x0 + n * larguraDente + larguraDente / 2 - f0.escova)
            if d < melhorDist:
                melhorDist = d
                f0.pior = n
        if limpos == CONFIG["dentesQtd"]:
            terminarTarefa("QUE SORRISO LINDO!")

    elif f0.tarefa == 3:
        # ---- VESTIR ----
        if teclas.get("ArrowLeft"):
            f0.tutiX -= v
            f0.olhando = -1
        if teclas.get("ArrowRight"):
            f0.tutiX += v
            f0.olhando = 1
        f0.tutiX = max(60, min(420, f0.tutiX))
        f0.andando = bool(teclas.get("ArrowLeft") or teclas.get("ArrowRight"))

        perto = None
        for p in ROUPAS:
            if not f0.vestido[p["chave"]] and abs(p["x"] - f0.tutiX) < 28:
                perto = p
                break
        f0.perto = perto
        if perto and foiApertada("Space"):
            f0.vestido[perto["chave"]] = True
            jogo.pontos += 50
            SFX.item()
        postas = sum(1 for p in ROUPAS if f0.vestido[p["chave"]])
        f0.prog = postas / len(ROUPAS) * 100
        if postas == len(ROUPAS):
            terminarTarefa("TÁ PRONTO PRA ESCOLA!")

