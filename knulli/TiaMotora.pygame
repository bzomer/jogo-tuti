# --------------------------------------------------------------------------
# TELA — inicialização do pygame
# --------------------------------------------------------------------------
try:
    pygame.mixer.pre_init(22050, -16, 1, 512)
except Exception:
    pass
pygame.init()

_JANELA = "-w" in sys.argv or "--window" in sys.argv
if _JANELA:
    screen = pygame.display.set_mode((960, 720))
else:
    screen = pygame.display.set_mode((0, 0), pygame.FULLSCREEN)
pygame.display.set_caption("Tia Motora em Missão!")
pygame.mouse.set_visible(False)

SCR_W, SCR_H = screen.get_size()
# mantém a proporção 4:3 dentro da tela do aparelho
_esc = min(SCR_W / W, SCR_H / H)
DEST_W, DEST_H = int(W * _esc), int(H * _esc)
DEST_X, DEST_Y = (SCR_W - DEST_W) // 2, (SCR_H - DEST_H) // 2

tela = pygame.Surface((W, H))       # o "canvas" de 480x360 do original
alvo = tela                         # superfície onde os helpers desenham

MG_W, MG_H = 448, 292
mg_surf = pygame.Surface((MG_W, MG_H))

clock = pygame.time.Clock()

# --------------------------------------------------------------------------
# DESENHO — utilitários (equivalentes do ctx do canvas)
# --------------------------------------------------------------------------
_cor_cache = {}

def col(c):
    """'#rrggbb' -> tupla RGB (com cache)."""
    t = _cor_cache.get(c)
    if t is None:
        t = (int(c[1:3], 16), int(c[3:5], 16), int(c[5:7], 16))
        _cor_cache[c] = t
    return t

def ret(cor, x, y, w, h):
    pygame.draw.rect(alvo, col(cor), (int(x), int(y), int(math.ceil(w)), int(math.ceil(h))))

def ret_alpha(rgba, x, y, w, h):
    w, h = int(math.ceil(w)), int(math.ceil(h))
    if w <= 0 or h <= 0:
        return
    s = pygame.Surface((w, h), pygame.SRCALPHA)
    s.fill(rgba)
    alvo.blit(s, (int(x), int(y)))

def ret_borda(cor, x, y, w, h, esp=2):
    pygame.draw.rect(alvo, col(cor), (int(x), int(y), int(w), int(h)), esp)

def linha(cor, x0, y0, x1, y1, esp=2):
    pygame.draw.line(alvo, col(cor), (int(x0), int(y0)), (int(x1), int(y1)), esp)

def circulo(cor, x, y, r, esp=0):
    pygame.draw.circle(alvo, col(cor), (int(x), int(y)), int(r), esp)

def poligono(cor, pontos):
    pygame.draw.polygon(alvo, col(cor), [(int(px), int(py)) for px, py in pontos])

_grad_cache = {}

def gradiente_v(x, y, w, h, stops):
    """gradiente vertical; stops = ((pos, cor), ...) — com cache."""
    key = (int(w), int(h), stops)
    s = _grad_cache.get(key)
    if s is None:
        w_i, h_i = int(w), int(h)
        s = pygame.Surface((w_i, h_i))
        st = [(p, col(c)) for p, c in stops]
        for linha_y in range(h_i):
            p = linha_y / max(1, h_i - 1)
            c0, c1, f = st[0][1], st[0][1], 0.0
            for i in range(len(st) - 1):
                if st[i][0] <= p <= st[i + 1][0]:
                    c0, c1 = st[i][1], st[i + 1][1]
                    span = st[i + 1][0] - st[i][0]
                    f = (p - st[i][0]) / span if span > 0 else 0.0
                    break
            else:
                if p > st[-1][0]:
                    c0 = c1 = st[-1][1]
            cor = tuple(int(c0[j] + (c1[j] - c0[j]) * f) for j in range(3))
            pygame.draw.line(s, cor, (0, linha_y), (w_i - 1, linha_y))
        _grad_cache[key] = s
    alvo.blit(s, (int(x), int(y)))

def larg(spr):
    return max(len(l) for l in spr)

_spr_cache = {}

def _render_spr(spr, esc, recolor, espelhar):
    rec_key = None
    if recolor:
        rec_key = tuple(sorted(recolor.items()))
    key = (id(spr), esc, rec_key, bool(espelhar))
    s = _spr_cache.get(key)
    if s is None:
        largura = larg(spr)
        s = pygame.Surface((largura * esc, len(spr) * esc), pygame.SRCALPHA)
        for j, linha_s in enumerate(spr):
            for i, ch in enumerate(linha_s):
                if ch == ".":
                    continue
                cor = (recolor.get(ch) if recolor else None) or CORES.get(ch)
                if not cor:
                    continue
                c = largura - 1 - i if espelhar else i
                s.fill(col(cor), (c * esc, j * esc, esc, esc))
        _spr_cache[key] = s
    return s

def sprite(spr, x, y, esc=None, recolor=None, espelhar=False):
    esc = esc or PX
    alvo.blit(_render_spr(spr, esc, recolor, espelhar), (int(round(x)), int(round(y))))

def spriteC(spr, cx_, cy_, esc=None, recolor=None, espelhar=False):
    esc = esc or PX
    sprite(spr, cx_ - (larg(spr) * esc) / 2, cy_ - (len(spr) * esc) / 2, esc, recolor, espelhar)

_fontes = {}

def fonte(tam):
    f = _fontes.get(tam)
    if f is None:
        f = pygame.font.Font(None, int(tam * 1.35))
        f.set_bold(True)
        _fontes[tam] = f
    return f

def medir(txt, tam):
    return fonte(tam).size(txt)[0]

# a fonte embutida do pygame não tem os glifos de seta do original
_TROCAS = (("←", "<"), ("→", ">"), ("↑", "^"), ("↓", "v"))

def texto(txt, x, y, tam=14, cor="#ffffff", align="center", sombra="#12131a"):
    for _de, _para in _TROCAS:
        if _de in txt:
            txt = txt.replace(_de, _para)
    f = fonte(tam)
    surf = f.render(txt, True, col(cor))
    w = surf.get_width()
    if align == "center":
        bx = x - w / 2
    elif align == "right":
        bx = x - w
    else:
        bx = x
    if sombra:
        alvo.blit(f.render(txt, True, col(sombra)), (int(bx + 2), int(y + 2)))
    alvo.blit(surf, (int(bx), int(y)))

def textoCoracao(txt, x, y, tam=14, cor="#ffffff"):
    texto(txt, x, y, tam, cor)
    w = medir(txt, tam)
    sprite(SPR["coracao"], x + w / 2 + 7, y + tam / 2 - 5, 2)

CINZA = {}
for _k in CORES:
    if CORES[_k]:
        CINZA[_k] = "#22262f" if _k == "k" else "#3a3f4c"

def painel(x, y, w, h, corBorda="#f7c948"):
    ret_alpha((9, 11, 20, 230), x, y, w, h)
    ret_borda(corBorda, x + 1, y + 1, w - 2, h - 2, 2)

def barra(x, y, w, h, frac, cor, corFundo="#1c2030"):
    frac = max(0.0, min(1.0, frac))
    ret(corFundo, x, y, w, h)
    ret(cor, x + 2, y + 2, max(0, (w - 4) * frac), h - 4)
    ret_borda("#12131a", x + 1, y + 1, w - 2, h - 2, 2)

# --------------------------------------------------------------------------
# SOM — sintetizado na inicialização (sem arquivos), como a WebAudio original
# --------------------------------------------------------------------------
som = NS(ligado=True, ok=False)
SR = 22050

def _amostra(tipo, fase):
    if tipo == "square":
        return 1.0 if fase < 0.5 else -1.0
    if tipo == "sawtooth":
        return 2.0 * fase - 1.0
    if tipo == "triangle":
        return 4.0 * fase - 1.0 if fase < 0.5 else 3.0 - 4.0 * fase
    return math.sin(2 * math.pi * fase)

def _sintetizar(notas, tipo="square", vol=0.05):
    total = sum(n[1] for n in notas) + 0.05
    buf = [0.0] * int(SR * total)
    t0 = 0.0
    ln_decai = math.log(0.0001)
    for freq, dur in notas:
        ini = int(SR * t0)
        n = int(SR * (dur + 0.03))
        for i in range(n):
            t = i / SR
            if t < 0.01:
                env = t / 0.01
            elif t < dur:
                env = math.exp(ln_decai * (t - 0.01) / max(0.001, dur - 0.01))
            else:
                env = 0.0
            fase = (t * freq) % 1.0
            idx = ini + i
            if idx < len(buf):
                buf[idx] += _amostra(tipo, fase) * env * vol
        t0 += dur
    saida = array("h", (int(max(-1.0, min(1.0, v * 6)) * 32000) for v in buf))
    return pygame.mixer.Sound(buffer=saida.tobytes())

SFX_SONS = {}

def _criar_sons():
    global SFX_SONS
    try:
        if pygame.mixer.get_init() is None:
            pygame.mixer.init(SR, -16, 1, 512)
        SFX_SONS = {
            "coleta":  _sintetizar([(880, .06), (1320, .09)]),
            "item":    _sintetizar([(660, .07), (880, .07), (1320, .12)]),
            "dano":    _sintetizar([(220, .1), (140, .18)], "sawtooth", .07),
            "turbo":   _sintetizar([(300, .05), (460, .05), (700, .12)], "square", .05),
            "grito":   _sintetizar([(500, .07), (760, .07), (1000, .16)], "triangle", .07),
            "porta":   _sintetizar([(400, .08), (600, .08), (900, .2)]),
            "fase":    _sintetizar([(523, .12), (659, .12), (784, .12), (1047, .3)]),
            "vitoria": _sintetizar([(523, .14), (659, .14), (784, .14), (1047, .18), (784, .1), (1047, .45)]),
            "fim":     _sintetizar([(440, .16), (330, .16), (247, .38)], "sawtooth", .06),
        }
        som.ok = True
    except Exception:
        som.ok = False

_criar_sons()

class _SFX:
    def __getattr__(self, nome):
        def tocar():
            if som.ligado and som.ok and nome in SFX_SONS:
                try:
                    SFX_SONS[nome].play()
                except Exception:
                    pass
        return tocar

SFX = _SFX()

# --------------------------------------------------------------------------
# CONTROLES — teclado e joystick (no Knulli o direcional já vira seta, mas o
# joystick também é lido direto, pra funcionar em qualquer aparelho)
# --------------------------------------------------------------------------
teclas = {}
apertadas = set()
ordemSetas = []
SETAS = ["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown"]

def apertar(code):
    if not teclas.get(code):
        apertadas.add(code)
        if code in SETAS:
            ordemSetas.append(code)
    teclas[code] = True

def soltar(code):
    teclas[code] = False
    if code in ordemSetas:
        ordemSetas.remove(code)

def foiApertada(code):
    return code in apertadas

def txAcao():
    return "AÇÃO"      # no console o botão físico é sempre "ação"

MAPA_TECLADO = {
    pygame.K_LEFT: "ArrowLeft", pygame.K_RIGHT: "ArrowRight",
    pygame.K_UP: "ArrowUp", pygame.K_DOWN: "ArrowDown",
    pygame.K_SPACE: "Space", pygame.K_RETURN: "Space",
    pygame.K_p: "KeyP", pygame.K_m: "KeyM",
}

# botões de rosto = ação; START = pausa; SELECT = som
BOTOES_ACAO = (0, 1, 2, 3)
BOTOES_PAUSA = (7, 9, 11)
BOTOES_SOM = (6, 8, 10)

pygame.joystick.init()
_joysticks = []
for _i in range(pygame.joystick.get_count()):
    _j = pygame.joystick.Joystick(_i)
    _j.init()
    _joysticks.append(_j)

_hat_estado = {}
_eixo_estado = {}
_botoes_baixados = set()

def _seta_virtual(codigo, ligado):
    if ligado:
        apertar(codigo)
    else:
        soltar(codigo)

def processar_eventos():
    """Devolve False quando é pra sair do jogo."""
    for ev in pygame.event.get():
        if ev.type == pygame.QUIT:
            return False
        elif ev.type == pygame.KEYDOWN:
            if ev.key == pygame.K_ESCAPE:
                return False
            c = MAPA_TECLADO.get(ev.key)
            if c:
                apertar(c)
        elif ev.type == pygame.KEYUP:
            c = MAPA_TECLADO.get(ev.key)
            if c:
                soltar(c)
        elif ev.type == pygame.JOYBUTTONDOWN:
            _botoes_baixados.add(ev.button)
            if ev.button in BOTOES_ACAO:
                apertar("Space")
            elif ev.button in BOTOES_PAUSA:
                apertar("KeyP")
            elif ev.button in BOTOES_SOM:
                apertar("KeyM")
            # SELECT + START (qualquer par som+pausa) = sair pro menu
            if (_botoes_baixados & set(BOTOES_PAUSA)) and (_botoes_baixados & set(BOTOES_SOM)):
                return False
        elif ev.type == pygame.JOYBUTTONUP:
            _botoes_baixados.discard(ev.button)
            if ev.button in BOTOES_ACAO:
                soltar("Space")
            elif ev.button in BOTOES_PAUSA:
                soltar("KeyP")
            elif ev.button in BOTOES_SOM:
                soltar("KeyM")
        elif ev.type == pygame.JOYHATMOTION:
            hx, hy = ev.value
            ant = _hat_estado.get((ev.instance_id, ev.hat), (0, 0))
            if hx != ant[0]:
                _seta_virtual("ArrowLeft", hx < 0)
                _seta_virtual("ArrowRight", hx > 0)
            if hy != ant[1]:
                _seta_virtual("ArrowUp", hy > 0)
                _seta_virtual("ArrowDown", hy < 0)
            _hat_estado[(ev.instance_id, ev.hat)] = (hx, hy)
        elif ev.type == pygame.JOYAXISMOTION and ev.axis in (0, 1):
            chave = (ev.instance_id, ev.axis)
            ant = _eixo_estado.get(chave, 0)
            novo = 0
            if ev.value < -0.5:
                novo = -1
            elif ev.value > 0.5:
                novo = 1
            if novo != ant:
                if ev.axis == 0:
                    _seta_virtual("ArrowLeft", novo == -1)
                    _seta_virtual("ArrowRight", novo == 1)
                else:
                    _seta_virtual("ArrowUp", novo == -1)
                    _seta_virtual("ArrowDown", novo == 1)
                _eixo_estado[chave] = novo
    return True


