    reiniciarFase=None,
    nomeFase="",
)

def trocarEstado(novo):
    jogo.estado = novo
    jogo.t = 0.0

def abrirFase(nome, reinicio):
    jogo.pontosFase = jogo.pontos
    jogo.vidas = CONFIG["vidas"]
    jogo.nomeFase = nome
    jogo.reiniciarFase = reinicio

