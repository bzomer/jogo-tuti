confete = []

def criarConfete():
    del confete[:]
    cores = ["#f7c948", "#f2a3c7", "#3fa34d", "#7fc4ff", "#d9463c", "#ffffff"]
    for _i in range(90):
        confete.append(NS(
            x=random.random() * W, y=-random.random() * H,
            vy=40 + random.random() * 90, vx=(random.random() - 0.5) * 30,
            cor=random.choice(cores),
            t=random.random() * 6,
        ))

def atualizarConfete(dt):
    for c in confete:
        c.y += c.vy * dt
        c.x += math.sin(c.t + jogo.t * 3) * 18 * dt + c.vx * dt
        if c.y > H + 8:
            c.y = -8.0
            c.x = random.random() * W

def desenharCasaDeLado(x, y, w, h):
    ret("#d9cfae", x, y + 20, w, h - 20)
    ret("#a8402f", x - 12, y, w + 24, 22)
    ret("#c9503a", x - 6, y + 20, w, 5)
    ret("#5b3a1a", x + 22, y + h - 56, 40, 56)
    ret("#f7c948", x + 54, y + h - 32, 4, 4)
    jx, jy = x + w - 88, y + 46
    ret("#5b3a1a", jx - 4, jy - 4, 76, 60)
    ret("#f7c948", jx, jy, 68, 52)
    ret("#6f4d80", jx + 8, jy + 24, 52, 20)
    ret("#3f6fd1", jx + 22, jy + 20, 34, 12)
    ret("#f3c39a", jx + 12, jy + 18, 12, 12)
    ret("#7a4a24", jx + 12, jy + 14, 12, 5)
    for i in range(3):
        p = (jogo.t * 0.5 + i / 3) % 1
        ret("#ffffff", jx + 26 + p * 14, jy + 14 - p * 12, 3 + i, 3 + i)
    ret("#5b3a1a", jx + 32, jy, 4, 52)

def desenharVitoria():
    fundoNoite()
    CHAO = 328
    desenharCasaDeLado(130, 176, 220, 124)
    ret("#2c5f37", 0, 296, W, H - 296)
    ret("#8b8b7a", 0, 302, W, H - 302)
    spriteC(SPR["nuna"], 72, CHAO - 21, 2)
    spriteC(SPR["carroLado"], 406, CHAO - 12, 2)
    for c in confete:
        ret(c.cor, int(c.x), int(c.y), 5, 5)

    texto("MISSÃO", W / 2, 10, 36, "#f7c948")
    texto("CUMPRIDA!", W / 2, 46, 36, "#f7c948")
    textoCoracao("BOA NOITE, " + CONFIG["nomeMenino"] + "! ATÉ AMANHÃ!", W / 2, 88, 13, "#f2a3c7")

    painel(96, 110, 288, 48)
    texto("PONTUAÇÃO FINAL", W / 2, 115, 11, "#c8c2ad")
    texto(str(int(jogo.pontos)).zfill(6), W / 2, 130, 24, "#f7c948")

    if int(jogo.t * 2) % 2 == 0:
        texto(txAcao() + " = JOGAR DE NOVO", W / 2, 162, 14, "#ffffff")

    painel(56, 332, 368, 26, "#f2a3c7")
    textoCoracao("CONQUISTA: " + CONFIG["nomeTia"] + " DO ANO", W / 2 - 8, 337, 13, "#f2a3c7")

def desenharGameOver():
    fundoNoite()
    texto("OPA!", W / 2, 70, 40, "#d9463c")
    texto("TENTA DE NOVO, " + CONFIG["nomeMenino"] + "!", W / 2, 122, 18, "#f7c948")
    texto(jogo.nomeFase, W / 2, 152, 12, "#c8c2ad")

    painel(96, 186, 288, 26, "#f2a3c7")
    texto("A TIA TÁ AQUI, VAMO DE NOVO!", W / 2, 191, 12, "#f2a3c7")

    CHAO = 306
    ret("#2c5f37", 0, 288, W, H - 288)
    ret("#8b8b7a", 0, 294, W, H - 294)
    spriteC(SPR["nuna"], 200, CHAO - 31, 3)
    spriteC(SPR["tutiBaixo0"], 262, CHAO - 25, 3)

    if int(jogo.t * 2) % 2 == 0:
        texto("APERTE " + txAcao(), W / 2, 330, 16, "#f7c948")

def desenharPausa():
    ret_alpha((9, 11, 20, 190), 0, 0, W, H)
    texto("PAUSADO", W / 2, 140, 34, "#f7c948")
    texto("APERTE START PRA VOLTAR", W / 2, 190, 14)

# ==========================================================================
# LOOP PRINCIPAL
# ==========================================================================
ATUALIZAR = {
    "MANHA": atualizarManha,
    "FASE1": atualizarFase1,
    "FASE2": atualizarFase2,
    "RECREIO": atualizarRecreio,
    "QUINTAL": atualizarQuintal,
    "SALA": atualizarSala,
}

DESENHAR = {
    "TITULO": desenharTitulo,
    "MANHA": desenharManha,
    "FASE1": desenharFase1,
    "INTERVALO": desenharIntervalo,
    "FASE2": desenharFase2,
    "RECREIO": desenharRecreio,
    "QUINTAL": desenharQuintal,
    "SALA": desenharSala,
    "TRANSICAO": desenharTransicao,
    "VITORIA": desenharVitoria,
    "GAMEOVER": desenharGameOver,
}

def atualizar_jogo(dt):
    # pausa / som
    if foiApertada("KeyP") and jogo.estado in ("MANHA", "FASE1", "FASE2", "RECREIO", "QUINTAL", "SALA"):
        jogo.pausado = not jogo.pausado
    if foiApertada("KeyM"):
        som.ligado = not som.ligado
        if som.ligado:
            SFX.coleta()

    if jogo.pausado:
        return
    jogo.t += dt
    jogo.tremor = max(0.0, jogo.tremor - dt * 1.6)

    estado = jogo.estado
    if estado == "TITULO":
        if foiApertada("Space"):
            jogo.pontos = 0
            SFX.fase()
            iniciarManha()
    elif estado == "INTERVALO":
        if foiApertada("Space"):
            iniciarFase2()
    elif estado == "TRANSICAO":
        if jogo.t > 0.5 and foiApertada("Space"):
            trans.proxima()
    elif estado == "VITORIA":
        atualizarConfete(dt)
        if jogo.t > 1 and foiApertada("Space"):
            jogo.pontos = 0
            trocarEstado("TITULO")
    elif estado == "GAMEOVER":
        if jogo.t > 0.6 and foiApertada("Space"):
            jogo.pontos = jogo.pontosFase
            if jogo.reiniciarFase:
                jogo.reiniciarFase()
    elif estado in ATUALIZAR:
        ATUALIZAR[estado](dt)

def desenhar_jogo():
    global alvo
    alvo = tela
    tela.fill(col("#0b0d16"))
    DESENHAR[jogo.estado]()
    if jogo.pausado:
        desenharPausa()
    if not som.ligado:
        texto("SOM OFF", 470, H - 16, 10, "#5d6272", "right")

def rodar():
    rodando = True
    while rodando:
        dt = min(0.05, clock.tick(60) / 1000.0)
        rodando = processar_eventos()

        atualizar_jogo(dt)
        desenhar_jogo()
        apertadas.clear()

        # ---- manda pra tela do aparelho, escalado ----
        quadro = tela
        if jogo.tremor > 0:
            # o tremor desloca o quadro inteiro, como o ctx.translate original
            dxt = (random.random() - 0.5) * jogo.tremor * 14
            dyt = (random.random() - 0.5) * jogo.tremor * 14
            tremido = pygame.Surface((W, H))
            tremido.fill(col("#0b0d16"))
            tremido.blit(tela, (int(dxt), int(dyt)))
            quadro = tremido
        screen.fill((11, 13, 22))
        pygame.transform.scale(quadro, (DEST_W, DEST_H), _quadro_escalado)
        screen.blit(_quadro_escalado, (DEST_X, DEST_Y))
        pygame.display.flip()

    pygame.quit()

_quadro_escalado = pygame.Surface((DEST_W, DEST_H))

if __name__ == "__main__":
    rodar()
